<%- include('partials/header', { titulo: 'Usuarios' }) %>
<%- include('partials/sidebar') %>
<div id="page-content">
  <div class="d-flex align-items-center mb-3">
    <button class="btn btn-sm btn-outline-secondary me-3 d-md-none" id="sidebarToggle"><i class="bi bi-list fs-5"></i></button>
    <h4 class="mb-0 fw-bold flex-grow-1">Usuarios</h4>
  </div>

  <div class="card border-0 shadow-sm mb-3 barra-filtros"><div class="card-body py-2">
    <div class="row align-items-center g-2">
      <div class="col-auto"><select id="searchCol" class="form-select form-select-sm">
        <option value="NOMBRE">Nombre</option><option value="APELLIDO">Apellido</option><option value="SERIE">Serie</option><option value="ID_USUARIOWEB">ID</option>
      </select></div>
      <div class="col col-md-4"><input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Buscar..."></div>
      <div class="col-auto ms-auto btn-action-group">
        <button class="btn btn-sm btn-success" onclick="openAdd()"><i class="bi bi-plus-lg"></i> Nuevo Usuario</button>
        <button class="btn btn-sm btn-primary" data-requires-selection disabled onclick="openEdit()"><i class="bi bi-pencil"></i> Editar</button>
        <button class="btn btn-sm btn-danger"  data-requires-selection disabled onclick="confirmDelete()"><i class="bi bi-trash"></i> Eliminar</button>
      </div>
    </div>
  </div></div>

  <div class="card border-0 shadow-sm"><div class="card-body p-0">
    <div class="table-responsive"><table class="table table-hover table-sm mb-0">
      <thead class="thead-tlc"><tr>
        <th data-sort="ID_USUARIOWEB" style="width:70px">ID <span class="sort-icon"></span></th>
        <th data-sort="NOMBRE">Nombre <span class="sort-icon"></span></th>
        <th data-sort="APELLIDO">Apellido <span class="sort-icon"></span></th>
        <th data-sort="SERIE" style="width:90px">Serie <span class="sort-icon"></span></th>
        <th style="width:110px">Status</th>
      </tr></thead>
      <tbody id="tableBody"></tbody>
    </table></div>
  </div>
  <div class="card-footer bg-white d-flex align-items-center justify-content-between py-2">
    <span class="page-info" id="pageInfo"></span>
    <div id="pagination">
      <button class="btn btn-sm btn-outline-secondary" data-action="prev"><i class="bi bi-chevron-left"></i> Anterior</button>
      <button class="btn btn-sm btn-outline-secondary" data-action="next">Siguiente <i class="bi bi-chevron-right"></i></button>
    </div>
  </div></div>
</div>

<!-- Modal Formulario -->
<div class="modal fade" id="frmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="frmTitle">Usuario</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="frmError" class="alert alert-danger d-none py-2 small"></div>
        <div class="row g-3">
          <div class="col-7">
            <label class="form-label fw-semibold">Nombre (login) <span class="text-danger">*</span></label>
            <input type="text" id="f_NOMBRE" class="form-control" maxlength="80" required>
          </div>
          <div class="col-5">
            <label class="form-label fw-semibold">Serie <span class="text-danger">*</span></label>
            <select id="f_SERIE" class="form-select" required>
              <option value="">— Selecciona —</option>
              <% centrales.forEach(c => { %>
                <option value="<%= c.Central.trim() %>"><%= c.Central.trim() %> — <%= c.Descripcion.trim() %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">Apellido</label>
            <input type="text" id="f_APELLIDO" class="form-control" maxlength="100">
          </div>
          <div class="col-7">
            <label class="form-label fw-semibold">Contraseña <span id="f_PASSWORD_req" class="text-danger">*</span></label>
            <input type="text" id="f_PASSWORD" class="form-control" maxlength="20">
            <div class="form-text" id="f_PASSWORD_hint" style="display:none">Dejar en blanco para no cambiarla.</div>
          </div>
          <div class="col-5 d-flex align-items-end">
            <div class="form-check">
              <input type="checkbox" class="form-check-input" id="f_ACTIVO">
              <label class="form-check-label fw-semibold" for="f_ACTIVO">Activo</label>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i> Cancelar</button>
        <button class="btn btn-primary" onclick="guardar()"><i class="bi bi-floppy"></i> Guardar</button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
<script>
const browse = initBrowse({
  searchInput: document.getElementById('searchInput'),
  searchColumn: document.getElementById('searchCol'),
  tableBody: document.getElementById('tableBody'),
  paginationEl: document.getElementById('pagination'),
  infoEl: document.getElementById('pageInfo'),
  fetchUrl: '/usuarios/data',
  defaultSort: 'NOMBRE',
  defaultDir: 'asc',
});

let _mode = 'add';
const modal = new bootstrap.Modal(document.getElementById('frmModal'));

function openAdd() {
  _mode = 'add';
  document.getElementById('frmTitle').textContent = 'Nuevo Usuario';
  document.getElementById('f_NOMBRE').value = '';
  document.getElementById('f_APELLIDO').value = '';
  document.getElementById('f_PASSWORD').value = '';
  document.getElementById('f_SERIE').value = '';
  document.getElementById('f_ACTIVO').checked = true;
  document.getElementById('f_PASSWORD_req').style.display = '';
  document.getElementById('f_PASSWORD_hint').style.display = 'none';
  document.getElementById('frmError').classList.add('d-none');
  modal.show();
}

function openEdit() {
  if (!window._selectedRow) return;
  _mode = 'edit';
  document.getElementById('frmTitle').textContent = 'Editar Usuario';
  document.getElementById('f_NOMBRE').value = window._selectedRow.NOMBRE || '';
  document.getElementById('f_APELLIDO').value = window._selectedRow.APELLIDO || '';
  document.getElementById('f_PASSWORD').value = '';
  document.getElementById('f_SERIE').value = window._selectedRow.SERIE || '';
  document.getElementById('f_ACTIVO').checked = !!Number(window._selectedRow.ACTIVO);
  document.getElementById('f_PASSWORD_req').style.display = 'none';
  document.getElementById('f_PASSWORD_hint').style.display = '';
  document.getElementById('frmError').classList.add('d-none');
  modal.show();
}

function guardar() {
  const errEl = document.getElementById('frmError');
  const nombre = document.getElementById('f_NOMBRE').value.trim();
  const serie = document.getElementById('f_SERIE').value.trim();
  const password = document.getElementById('f_PASSWORD').value.trim();
  if (!nombre || !serie) { errEl.textContent = 'Nombre y Serie son requeridos.'; errEl.classList.remove('d-none'); return; }
  if (_mode === 'add' && !password) { errEl.textContent = 'La contraseña es requerida.'; errEl.classList.remove('d-none'); return; }

  fetch('/usuarios/guardar', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      ID_USUARIOWEB: window._selectedRow ? window._selectedRow.ID_USUARIOWEB : null,
      NOMBRE: nombre,
      APELLIDO: document.getElementById('f_APELLIDO').value.trim(),
      PASSWORD: password,
      SERIE: serie,
      ACTIVO: document.getElementById('f_ACTIVO').checked ? 1 : 0,
      _mode,
    })
  }).then(r => r.json()).then(d => {
    if (d.error) { errEl.textContent = d.error; errEl.classList.remove('d-none'); return; }
    modal.hide(); browse.load();
  });
}

function confirmDelete() {
  if (!window._selectedRow) return;
  if (!confirm(`¿Eliminar el usuario "${window._selectedRow.NOMBRE}"? También se quitará de cualquier grupo de Seguridad al que pertenezca.`)) return;
  fetch('/usuarios/eliminar', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ID_USUARIOWEB: window._selectedRow.ID_USUARIOWEB })
  }).then(r => r.json()).then(d => {
    if (d.error) { alert(d.error); return; }
    browse.load();
  });
}
</script>
