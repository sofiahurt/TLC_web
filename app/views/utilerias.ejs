<%- include('partials/header', { titulo: 'Utilerías' }) %>
<%- include('partials/sidebar') %>
<div id="page-content">
  <div class="d-flex align-items-center mb-3">
    <button class="btn btn-sm btn-outline-secondary me-3 d-md-none" id="sidebarToggle"><i class="bi bi-list fs-5"></i></button>
    <h4 class="mb-0 fw-bold flex-grow-1">Utilerías</h4>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white">
      <h6 class="mb-0 fw-bold"><i class="bi bi-file-earmark-zip me-2 text-primary"></i>Copiar y renombrar XML</h6>
    </div>
    <div class="card-body">
      <p class="text-muted small">
        Copia los XML timbrados desde otra carpeta a la carpeta de XML del sistema
        (<code><%= rutaXml %></code>), renombrándolos al formato que usa TLC Web.
        Elija la carpeta origen y marque los documentos que desea copiar.
        Nunca se modifica ni se elimina nada en la carpeta origen, y si el archivo destino ya existe, se omite.
      </p>
      <div id="copiarXmlError" class="alert alert-danger d-none py-2 small"></div>

      <div class="row g-3">
        <div class="col-12">
          <label class="form-label fw-semibold small mb-1">Carpeta origen</label>
          <div class="input-group">
            <input type="text" id="cx_CarpetaOrigen" class="form-control" placeholder="Ej. E:\Exportados\XML">
            <button class="btn btn-outline-secondary" type="button" onclick="openFsBrowser()"><i class="bi bi-search"></i></button>
          </div>
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold small mb-1">Documentos a copiar</label>
          <div class="border rounded p-2">
            <div class="form-check mb-1 pb-1 border-bottom">
              <input class="form-check-input" type="checkbox" id="cx_Todos" checked onchange="marcarTodos(this.checked)">
              <label class="form-check-label fw-semibold small" for="cx_Todos">Seleccionar todos</label>
            </div>
            <div id="cx_Tipos" class="row g-1"><div class="col-12 small text-muted">Cargando...</div></div>
          </div>
        </div>
        <div class="col-md-4">
          <button class="btn btn-primary w-100" id="btnCopiarXml" onclick="ejecutarCopiarXml()"><i class="bi bi-copy me-1"></i>Copiar archivos</button>
        </div>
      </div>

      <div id="copiarXmlResultado" class="mt-4 d-none">
        <hr>
        <div id="copiarXmlResumen" class="mb-2 small"></div>
        <div id="copiarXmlDetalle"></div>
      </div>
    </div>
  </div>

  <% if (tienePermiso('utilerias.importarfacturas')) { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white">
      <h6 class="mb-0 fw-bold"><i class="bi bi-receipt me-2 text-primary"></i>Importar facturas desde XML CFDI</h6>
    </div>
    <div class="card-body">
      <p class="text-muted small">
        Lee los XML CFDI 4.0 de una carpeta del servidor y da de alta las facturas de <strong>Ingreso</strong> con sus conceptos.
        Los de otro tipo se omiten; si la Serie + Folio ya existe no se inserta. Cada XML importado se guarda en
        <code><%= rutaXml %></code> como <code>FAC_{Serie}{Folio}_Timbrada.xml</code>. Nunca se modifica la carpeta origen.
      </p>
      <div id="impFacError" class="alert alert-danger d-none py-2 small"></div>
      <div class="row g-3">
        <div class="col-12">
          <label class="form-label fw-semibold small mb-1">Carpeta origen</label>
          <div class="input-group">
            <input type="text" id="if_CarpetaOrigen" class="form-control" placeholder="Ej. E:\Exportados\XML">
            <button class="btn btn-outline-secondary" type="button" onclick="openFsBrowser('if_CarpetaOrigen')"><i class="bi bi-search"></i></button>
          </div>
        </div>
        <div class="col-12">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="if_Completar">
            <label class="form-check-label small" for="if_Completar">Si la factura ya existe pero no tiene UUID, completar UUID / Fecha de timbrado / RFC del PAC</label>
          </div>
        </div>
        <div class="col-md-4">
          <button class="btn btn-primary w-100" id="btnImportarFac" onclick="ejecutarImportarFacturas()"><i class="bi bi-box-arrow-in-down me-1"></i>Importar facturas</button>
        </div>
      </div>
      <div id="impFacProgreso" class="mt-3 d-none">
        <div class="progress" style="height:18px"><div id="impFacBarra" class="progress-bar" style="width:0%">0%</div></div>
        <div id="impFacEstado" class="small text-muted mt-1"></div>
      </div>
      <div id="impFacResultado" class="mt-3 d-none"></div>
    </div>
  </div>
  <% } %>
</div>

<!-- Explorador de carpetas del servidor -->
<div class="modal fade modal-lookup" id="fsBrowserModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg">
  <div class="modal-content">
    <div class="modal-header py-2">
      <h6 class="modal-title">Seleccionar carpeta</h6>
      <button class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
      <div id="fsBrowserError" class="alert alert-danger d-none py-2 small"></div>
      <div class="input-group input-group-sm mb-2">
        <span class="input-group-text">Ruta actual</span>
        <input type="text" id="fsCurrentPath" class="form-control" readonly>
      </div>
      <div class="list-group" id="fsEntries" style="max-height:320px;overflow-y:auto"></div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
      <button type="button" class="btn btn-primary btn-sm" id="btnUsarCarpeta" onclick="usarCarpetaActual()" disabled>
        <i class="bi bi-check-lg me-1"></i>Usar esta carpeta
      </button>
    </div>
  </div>
</div></div>

<%- include('partials/footer') %>
<script>
const fsBrowserModal = new bootstrap.Modal(document.getElementById('fsBrowserModal'));
let _fsCurrentPath = '';
let _fsTarget = 'cx_CarpetaOrigen';

function openFsBrowser(target){
  _fsTarget = target || 'cx_CarpetaOrigen';
  document.getElementById('fsBrowserError').classList.add('d-none');
  const inicial = document.getElementById(_fsTarget).value.trim();
  fsBrowserModal.show();
  fsLoad(inicial);
}

function fsLoad(rutaPedida){
  fetch(`/utilerias/fs/list?path=${encodeURIComponent(rutaPedida||'')}`).then(r=>r.json()).then(d=>{
    const errEl=document.getElementById('fsBrowserError');
    if(d.error){ errEl.textContent=d.error; errEl.classList.remove('d-none'); return; }
    errEl.classList.add('d-none');
    _fsCurrentPath = d.path || '';
    document.getElementById('fsCurrentPath').value = _fsCurrentPath || '(unidades de disco)';
    document.getElementById('btnUsarCarpeta').disabled = !_fsCurrentPath;

    const entries = [];
    if (d.parent !== null && d.parent !== undefined) {
      entries.push(`<button type="button" class="list-group-item list-group-item-action" onclick="fsLoad(${JSON.stringify(d.parent).replace(/"/g,'&quot;')})"><i class="bi bi-arrow-90deg-up me-2"></i>..</button>`);
    }
    (d.entries||[]).forEach(en=>{
      entries.push(`<button type="button" class="list-group-item list-group-item-action" onclick="fsLoad(${JSON.stringify(en.ruta).replace(/"/g,'&quot;')})"><i class="bi bi-folder me-2 text-warning"></i>${en.nombre}</button>`);
    });
    document.getElementById('fsEntries').innerHTML = entries.join('') || '<div class="text-muted small p-2">Sin subcarpetas.</div>';
  }).catch(()=>{
    const errEl=document.getElementById('fsBrowserError');
    errEl.textContent='Error de comunicación con el servidor.'; errEl.classList.remove('d-none');
  });
}

function usarCarpetaActual(){
  if(!_fsCurrentPath) return;
  document.getElementById(_fsTarget).value = _fsCurrentPath;
  fsBrowserModal.hide();
}

function cargarTipos(){
  fetch('/utilerias/tipos-xml').then(r=>r.json()).then(tipos=>{
    document.getElementById('cx_Tipos').innerHTML = tipos.map(t=>
      `<div class="col-md-6"><div class="form-check">
        <input class="form-check-input cx-tipo" type="checkbox" id="cx_t_${t.clave}" value="${t.clave}" checked onchange="actualizarTodos()">
        <label class="form-check-label small" for="cx_t_${t.clave}"><strong>${t.etiqueta}</strong>
          <span class="text-muted">— <code>${t.origen}</code> → <code>${t.destino}</code></span></label>
      </div></div>`).join('');
  }).catch(()=>{ document.getElementById('cx_Tipos').innerHTML='<div class="col-12 small text-danger">No se pudo cargar la lista de documentos.</div>'; });
}
function marcarTodos(v){ document.querySelectorAll('.cx-tipo').forEach(c=>c.checked=v); }
function actualizarTodos(){
  const cs=[...document.querySelectorAll('.cx-tipo')];
  document.getElementById('cx_Todos').checked = cs.length>0 && cs.every(c=>c.checked);
}
cargarTipos();

function ejecutarCopiarXml(){
  const errEl=document.getElementById('copiarXmlError');
  errEl.classList.add('d-none');
  const carpetaOrigen=document.getElementById('cx_CarpetaOrigen').value.trim();
  const tipos=[...document.querySelectorAll('.cx-tipo:checked')].map(c=>c.value);
  if(!carpetaOrigen){
    errEl.textContent='La carpeta origen es requerida.'; errEl.classList.remove('d-none'); return;
  }
  if(!tipos.length){
    errEl.textContent='Seleccione al menos un tipo de documento.'; errEl.classList.remove('d-none'); return;
  }
  const btn=document.getElementById('btnCopiarXml');
  btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Copiando...';
  fetch('/utilerias/copiar-xml',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({carpetaOrigen,tipos})})
    .then(r=>r.json()).then(d=>{
      btn.disabled=false; btn.innerHTML='<i class="bi bi-copy me-1"></i>Copiar archivos';
      if(d.error){ errEl.textContent=d.error; errEl.classList.remove('d-none'); return; }
      pintarResultadoCopiarXml(d);
    }).catch(()=>{
      btn.disabled=false; btn.innerHTML='<i class="bi bi-copy me-1"></i>Copiar archivos';
      errEl.textContent='Error de comunicación con el servidor.'; errEl.classList.remove('d-none');
    });
}

function pintarResultadoCopiarXml(d){
  document.getElementById('copiarXmlResultado').classList.remove('d-none');
  document.getElementById('copiarXmlResumen').innerHTML =
    `Archivos encontrados: <strong>${d.totalEncontrados}</strong> — `+
    `<span class="text-success">${d.copiados.length} copiados</span>, `+
    `<span class="text-warning">${d.omitidos.length} omitidos (ya existían)</span>, `+
    `<span class="text-danger">${d.errores.length} con error</span>.` +
    `<div class="text-muted mt-1">${(d.porTipo||[]).map(t=>`${t.tipo}: ${t.encontrados}`).join(' · ')}</div>`;

  const tabla = (titulo, filas, cols) => {
    if (!filas.length) return '';
    const head = cols.map(c=>`<th>${c.label}</th>`).join('');
    const body = filas.map(f=>`<tr>${cols.map(c=>`<td class="small">${f[c.key]||''}</td>`).join('')}</tr>`).join('');
    return `<div class="mb-3"><div class="fw-semibold small mb-1">${titulo}</div>
      <table class="table table-sm table-bordered mb-0"><thead class="table-light"><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>`;
  };

  document.getElementById('copiarXmlDetalle').innerHTML =
    tabla('Copiados', d.copiados, [{key:'tipo',label:'Tipo'},{key:'origen',label:'Archivo origen'},{key:'destino',label:'Archivo destino'}]) +
    tabla('Omitidos', d.omitidos, [{key:'tipo',label:'Tipo'},{key:'origen',label:'Archivo origen'},{key:'destino',label:'Archivo destino'},{key:'motivo',label:'Motivo'}]) +
    tabla('Errores', d.errores, [{key:'tipo',label:'Tipo'},{key:'origen',label:'Archivo origen'},{key:'motivo',label:'Motivo'}]);
}

const _esc = t => String(t==null?'':t).replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function ejecutarImportarFacturas(){
  const errEl=document.getElementById('impFacError'); errEl.classList.add('d-none');
  const carpetaOrigen=document.getElementById('if_CarpetaOrigen').value.trim();
  if(!carpetaOrigen){ errEl.textContent='La carpeta origen es requerida.'; errEl.classList.remove('d-none'); return; }
  const btn=document.getElementById('btnImportarFac');
  btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Importando...';
  document.getElementById('impFacResultado').classList.add('d-none');
  fetch('/utilerias/importar-facturas',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({carpetaOrigen,completarUuid:document.getElementById('if_Completar').checked})})
    .then(r=>r.json()).then(d=>{
      if(d.error){ throw new Error(d.error); }
      document.getElementById('impFacProgreso').classList.remove('d-none');
      sondearImportacion(d.id);
    }).catch(e=>{ impFacFin(); errEl.textContent=e.message||'Error de comunicación con el servidor.'; errEl.classList.remove('d-none'); });
}
function impFacFin(){ const b=document.getElementById('btnImportarFac'); b.disabled=false; b.innerHTML='<i class="bi bi-box-arrow-in-down me-1"></i>Importar facturas'; }
function sondearImportacion(id){
  fetch('/utilerias/importar-facturas/estado/'+id).then(r=>r.json()).then(t=>{
    if(t.error) throw new Error(t.error);
    const pct=t.total?Math.round(t.procesados*100/t.total):100;
    const barra=document.getElementById('impFacBarra'); barra.style.width=pct+'%'; barra.textContent=pct+'%';
    document.getElementById('impFacEstado').textContent=`Procesados ${t.procesados} de ${t.total}`;
    if(!t.terminado){ setTimeout(()=>sondearImportacion(id),700); return; }
    impFacFin(); pintarImportacion(t);
  }).catch(e=>{ impFacFin(); const el=document.getElementById('impFacError'); el.textContent=e.message||'Error de comunicación.'; el.classList.remove('d-none'); });
}
function pintarImportacion(t){
  const box=document.getElementById('impFacResultado'); box.classList.remove('d-none');
  const filas=(est,titulo,extra)=>{
    const f=t.detalle.filter(x=>x.estado===est); if(!f.length) return '';
    return `<div class="mb-3"><div class="fw-semibold small mb-1">${titulo}</div><table class="table table-sm table-bordered mb-0"><thead class="table-light"><tr><th>Archivo</th><th>Factura</th><th>Detalle</th></tr></thead><tbody>`+
      f.map(x=>`<tr><td class="small">${_esc(x.archivo)}</td><td class="small">${_esc(x.factura||'')}</td><td class="small">${_esc(extra?extra(x):(x.motivo||''))}</td></tr>`).join('')+`</tbody></table></div>`;
  };
  const sinCli=t.detalle.filter(x=>x.clienteNoEncontrado);
  const avisos=t.detalle.filter(x=>(x.advertencias||[]).length);
  box.innerHTML=
    `<div class="small mb-2">Total: <strong>${t.total}</strong> — <span class="text-success">${t.importadas} importadas</span>, `+
    `<span class="text-primary">${t.completadas} completadas</span>, <span class="text-warning">${t.existentes} ya existían</span>, `+
    `<span class="text-secondary">${t.omitidas} omitidas por tipo</span>, <span class="text-danger">${t.errores} con error</span>, `+
    `${t.clientesNoEncontrados} clientes no encontrados.</div>`+
    (t.errorGeneral?`<div class="alert alert-danger py-2 small">${_esc(t.errorGeneral)}</div>`:'')+
    filas('importada','Importadas',x=>`${x.conceptos} concepto(s)`)+filas('completada','Completadas')+filas('existente','Ya existentes')+
    filas('omitida','Omitidas')+filas('error','Con error')+
    (sinCli.length?`<div class="mb-3"><div class="fw-semibold small mb-1">Clientes no encontrados (importadas con Id_Cliente = 0)</div><table class="table table-sm table-bordered mb-0"><tbody>`+
      sinCli.map(x=>`<tr><td class="small">${_esc(x.factura||x.archivo)}</td><td class="small">${_esc(x.clienteNoEncontrado)}</td></tr>`).join('')+`</tbody></table></div>`:'')+
    (avisos.length?`<div class="mb-3"><div class="fw-semibold small mb-1">Advertencias</div><ul class="small mb-0">`+
      avisos.flatMap(x=>x.advertencias.map(a=>`<li>${_esc(x.factura||x.archivo)}: ${_esc(a)}</li>`)).join('')+`</ul></div>`:'');
}
</script>
