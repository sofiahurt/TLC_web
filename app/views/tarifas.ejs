<%- include('partials/header', { titulo: 'Tarifas' }) %>
<%- include('partials/sidebar') %>
<div id="page-content">
  <div class="d-flex align-items-center mb-3">
    <button class="btn btn-sm btn-outline-secondary me-3 d-md-none" id="sidebarToggle"><i class="bi bi-list fs-5"></i></button>
    <h4 class="mb-0 fw-bold flex-grow-1">Tarifas</h4>
  </div>
  <div class="card border-0 shadow-sm mb-3 barra-filtros"><div class="card-body py-2">
    <div class="row align-items-center g-2">
      <div class="col-auto"><select id="searchCol" class="form-select form-select-sm">
        <option value="ID_TARIFA">ID</option><option value="CDORIGEN">Origen</option><option value="CDDESTINO">Destino</option><option value="FLETE">Tipo Flete</option><option value="NOMBRECOMUNCLI">Cliente</option><option value="NOMBRECOMUNTRANS">Transportista</option>
      </select></div>
      <div class="col col-md-4"><input type="text" id="searchInput" class="form-control form-select-sm" placeholder="Buscar..."></div>
      <div class="col-auto ms-auto btn-action-group">
        <% if (tienePermiso('tarifas.btn_exportar')) { %>
        <button class="btn btn-sm btn-outline-success" onclick="exportarExcel()" title="Exporta las tarifas (según la búsqueda activa) a Excel"><i class="bi bi-file-earmark-excel"></i> Excel</button>
        <% } %>
        <button class="btn btn-sm btn-success" onclick="openAdd()"><i class="bi bi-plus-lg"></i> Agregar</button>
        <button class="btn btn-sm btn-primary" data-requires-selection disabled onclick="openEdit()"><i class="bi bi-pencil"></i> Editar</button>
        <button class="btn btn-sm btn-danger" data-requires-selection disabled onclick="confirmDelete()"><i class="bi bi-trash"></i> Eliminar</button>
      </div>
    </div>
  </div></div>
  <div class="card border-0 shadow-sm"><div class="card-body p-0">
    <div class="table-responsive"><table class="table table-hover table-sm mb-0">
      <thead class="thead-tlc"><tr>
        <th data-sort="ID_TARIFA" style="width:70px">ID <span class="sort-icon"></span></th>
        <th data-sort="CDORIGEN">Origen <span class="sort-icon"></span></th>
        <th data-sort="CDDESTINO">Destino <span class="sort-icon"></span></th>
        <th data-sort="FLETE">Flete <span class="sort-icon"></span></th>
        <th data-sort="NOMBRECOMUNCLI">Cliente <span class="sort-icon"></span></th>
        <th data-sort="NOMBRECOMUNTRANS">Transportista <span class="sort-icon"></span></th>
        <th data-sort="COSTO" style="width:80px">Costo <span class="sort-icon"></span></th>
        <th data-sort="VENTA" style="width:80px">Venta <span class="sort-icon"></span></th>
      </tr></thead>
      <tbody id="tableBody"></tbody>
    </table></div>
  </div>
  <div class="card-footer bg-white d-flex align-items-center justify-content-between py-2">
    <span class="page-info" id="pageInfo"></span>
    <div id="pagination">
      <button class="btn btn-sm btn-outline-secondary" data-action="prev"><i class="bi bi-chevron-left"></i> Anterior</button>
      <button class="btn btn-sm btn-outline-secondary" data-action="next">Siguiente <i class="bi bi-chevron-right"></i></button>
    </div>
  </div></div>
</div>

<!-- Modal Formulario -->
<div class="modal fade" id="frmModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-xl">
  <div class="modal-content">
    <div class="modal-header"><h5 class="modal-title" id="frmTitle">Tarifa</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body" style="max-height:75vh;overflow-y:auto">
      <div id="frmError" class="alert alert-danger d-none py-2 small"></div>
      <!-- Datos Generales -->
      <div class="card mb-3"><div class="card-header py-1 fw-semibold small">Datos Generales</div><div class="card-body"><div class="row g-3">
        <div class="col-md-2"><label class="form-label fw-semibold">ID <span class="text-danger">*</span></label><input type="number" id="f_ID_TARIFA" class="form-control"></div>
        <div class="col-md-3"><label class="form-label fw-semibold">Flete</label><div class="input-group"><input type="hidden" id="f_ID_TIPOFLETE"><input type="text" id="f_FLETE" class="form-control" placeholder="Seleccionar..." readonly><button class="btn btn-outline-secondary" type="button" onclick="openLk('tipoflete')"><i class="bi bi-search"></i></button></div></div>
        <div class="col-md-3"><label class="form-label fw-semibold">Transportista</label><div class="input-group"><input type="hidden" id="f_ID_TRANSPORTISTA"><input type="text" id="f_NOMBRECOMUNTRANS" class="form-control" placeholder="Seleccionar..." readonly><button class="btn btn-outline-secondary" type="button" onclick="openLk('transport')"><i class="bi bi-search"></i></button></div></div>
        <div class="col-md-4"><label class="form-label fw-semibold">Cliente</label><div class="input-group"><input type="hidden" id="f_ID_CLIENTE"><input type="text" id="f_NOMBRECOMUNCLI" class="form-control" placeholder="Seleccionar..." readonly><button class="btn btn-outline-secondary" type="button" onclick="openLk('clientes')"><i class="bi bi-search"></i></button></div></div>
      </div></div></div>
      <!-- Destinos de la ruta -->
      <div class="card mb-3"><div class="card-header py-1 fw-semibold small">Destinos de la ruta</div><div class="card-body"><div class="row g-3">
        <div class="col-md-5"><label class="form-label fw-semibold">Ciudad Origen</label><div class="input-group"><input type="hidden" id="f_ID_CIUDADORIGEN"><input type="text" id="f_CDORIGEN" class="form-control" placeholder="Seleccionar..." readonly><button class="btn btn-outline-secondary" type="button" onclick="openLk('origen')"><i class="bi bi-search"></i></button></div></div>
        <div class="col-md-5"><label class="form-label fw-semibold">Ciudad Destino</label><div class="input-group"><input type="hidden" id="f_ID_CIUDADDESTINO"><input type="text" id="f_CDDESTINO" class="form-control" placeholder="Seleccionar..." readonly><button class="btn btn-outline-secondary" type="button" onclick="openLk('destino')"><i class="bi bi-search"></i></button></div></div>
        <div class="col-md-2"><label class="form-label fw-semibold">Kilómetros</label><input type="number" id="f_KILOMETROS" class="form-control"></div>
        <div class="col-md-12"><label class="form-label fw-semibold">Descripción Flete</label><input type="text" id="f_DESFLETE" class="form-control" readonly style="background:#e9ecef" maxlength="80"></div>
      </div></div></div>
      <!-- Costos -->
      <div class="card"><div class="card-header py-1 fw-semibold small">Costos</div><div class="card-body"><div class="row g-3">
        <div class="col-md-6">
          <div class="mb-2"><label class="form-label fw-semibold small mb-1">Flete/Renta</label><input type="text" inputmode="decimal" id="f_RENTA" class="form-control form-control-sm text-end money"  value="$0.00"></div>
          <div class="mb-2"><label class="form-label fw-semibold small mb-1">Costo Kilómetros</label><input type="text" inputmode="decimal" id="f_COSTOKILOMTS" class="form-control form-control-sm text-end money"  value="$0.00"></div>
          <div class="mb-2"><label class="form-label fw-semibold small mb-1">Costo Autopistas</label><input type="text" inputmode="decimal" id="f_COSTOAUTOPISTAS" class="form-control form-control-sm text-end money"  value="$0.00"></div>
          <div class="mb-2"><label class="form-label fw-semibold small mb-1">Venta</label><input type="text" inputmode="decimal" id="f_VENTA" class="form-control form-control-sm text-end money" readonly style="background:#e9ecef;font-weight:600" value="$0.00"></div>
        </div>
        <div class="col-md-6">
          <div class="mb-2"><label class="form-label fw-semibold small mb-1">Moneda Venta</label><div class="input-group input-group-sm"><input type="text" id="f_MONVENTA" class="form-control" placeholder="Seleccionar..." readonly><button class="btn btn-outline-secondary" type="button" onclick="openLk('moneda')"><i class="bi bi-search"></i></button></div></div>
          <div class="mb-2"><label class="form-label fw-semibold small mb-1">Tipo Cambio</label><input type="number" id="f_TIPOCAMBIO" class="form-control form-control-sm" step="0.0001"></div>
          <div class="mb-2"><label class="form-label fw-semibold small mb-1">Diesel Permitido</label><input type="number" id="f_DIESELPERMITIDO" class="form-control form-control-sm" step="0.01"></div>
          <div class="mb-2"><label class="form-label fw-semibold small mb-1">Pago Tarifa</label><input type="text" inputmode="decimal" id="f_PAGOTARIFA" class="form-control form-control-sm text-end money"  value="$0.00"></div>
          <div class="d-flex gap-4 flex-nowrap mt-3">
            <div class="form-check"><input type="checkbox" id="f_FLAGIVA" class="form-check-input"><label class="form-check-label text-nowrap" for="f_FLAGIVA">Sin IVA</label></div>
            <div class="form-check"><input type="checkbox" id="f_FLAGRET" class="form-check-input"><label class="form-check-label text-nowrap" for="f_FLAGRET">Sin Retención</label></div>
            <div class="form-check"><input type="checkbox" id="f_FLAGOCULTAR" class="form-check-input"><label class="form-check-label text-nowrap" for="f_FLAGOCULTAR">Ocultar</label></div>
          </div>
        </div>
      </div></div></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i> Cancelar</button>
      <button class="btn btn-primary" onclick="guardar()"><i class="bi bi-floppy"></i> Guardar</button>
    </div>
  </div>
</div></div>

<!-- Lookup genérico -->
<div class="modal fade modal-lookup" id="lookupGen" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg">
  <div class="modal-content">
    <div class="modal-header py-2"><h6 class="modal-title" id="lkGenTitle">Seleccionar</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <input type="text" id="lkGenQ" class="form-control form-control-sm mb-2" placeholder="Buscar...">
      <table class="table table-hover table-sm"><thead class="table-secondary"><tr id="lkGenHead"></tr></thead><tbody id="lkGenBody"></tbody></table>
      <div class="d-flex justify-content-between align-items-center"><span id="lkGenInfo" class="small text-muted"></span><div><button class="btn btn-sm btn-outline-secondary" id="lkGenPrev">‹</button> <button class="btn btn-sm btn-outline-secondary" id="lkGenNext">›</button></div></div>
    </div>
  </div>
</div></div>

<%- include('partials/footer') %>
<script>
function exportarExcel(){
  window.location='/tarifas/excel?q='+encodeURIComponent(document.getElementById('searchInput').value.trim())+'&col='+encodeURIComponent(document.getElementById('searchCol').value);
}
const browse=initBrowse({searchInput:document.getElementById('searchInput'),searchColumn:document.getElementById('searchCol'),tableBody:document.getElementById('tableBody'),paginationEl:document.getElementById('pagination'),infoEl:document.getElementById('pageInfo'),fetchUrl:'/tarifas/data'});
let _mode='add';const modal=new bootstrap.Modal(document.getElementById('frmModal'));
const numFlds=['ID_TARIFA','TIPOCAMBIO','KILOMETROS','DIESELPERMITIDO'];
const moneyFlds=['RENTA','COSTOKILOMTS','COSTOAUTOPISTAS','VENTA','PAGOTARIFA'];
const txtFlds=['DESFLETE','MONVENTA'];
const chkFlds=['FLAGOCULTAR','FLAGIVA','FLAGRET'];
const lkFlds=['ID_CIUDADORIGEN','ID_CIUDADDESTINO','ID_TIPOFLETE','ID_TRANSPORTISTA','ID_CLIENTE','CDORIGEN','CDDESTINO','FLETE','NOMBRECOMUNTRANS','NOMBRECOMUNCLI'];
const g=id=>document.getElementById(id);
function fmtMoney(v){const n=parseFloat(v)||0;return (n<0?'-':'')+'$'+Math.abs(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});}
function parseMoney(v){return parseFloat(String(v==null?'':v).replace(/[^0-9.-]/g,''))||0;}
function recalcVenta(){g('f_VENTA').value=fmtMoney(Math.round((parseMoney(g('f_RENTA').value)+parseMoney(g('f_COSTOKILOMTS').value)+parseMoney(g('f_COSTOAUTOPISTAS').value))*100)/100);}
function armaDesFlete(){const o=g('f_CDORIGEN').value.trim(),d=g('f_CDDESTINO').value.trim();g('f_DESFLETE').value=(o||d)?(o+' - '+d).slice(0,80):'';}
moneyFlds.forEach(f=>{const el=g('f_'+f);if(el.readOnly)return;el.addEventListener('focus',()=>{const n=parseMoney(el.value);el.value=n?String(n):'';el.select();});el.addEventListener('blur',()=>{el.value=fmtMoney(el.value);recalcVenta();});el.addEventListener('input',()=>{if(f==='PAGOTARIFA')return;const tot=['RENTA','COSTOKILOMTS','COSTOAUTOPISTAS'].reduce((a,k)=>a+(k===f?parseMoney(el.value):parseMoney(g('f_'+k).value)),0);g('f_VENTA').value=fmtMoney(Math.round(tot*100)/100);});});
function clearForm(){[...numFlds,...txtFlds,...lkFlds].forEach(f=>{g('f_'+f).value='';});moneyFlds.forEach(f=>g('f_'+f).value=fmtMoney(0));chkFlds.forEach(f=>g('f_'+f).checked=false);}
function openAdd(){_mode='add';g('frmTitle').textContent='Nueva Tarifa';clearForm();g('f_ID_TARIFA').readOnly=false;g('frmError').classList.add('d-none');modal.show();}
function openEdit(){if(!window._selectedRow)return;_mode='edit';const r=window._selectedRow;g('frmTitle').textContent='Editar Tarifa';clearForm();[...numFlds,...txtFlds,...lkFlds].forEach(f=>{g('f_'+f).value=(r[f]==null?'':r[f]);});moneyFlds.forEach(f=>g('f_'+f).value=fmtMoney(r[f]));chkFlds.forEach(f=>g('f_'+f).checked=r[f]=='1');recalcVenta();armaDesFlete();g('f_ID_TARIFA').readOnly=true;g('frmError').classList.add('d-none');modal.show();}
function getBody(){const b={_mode};[...numFlds,...txtFlds,...lkFlds].forEach(f=>b[f]=g('f_'+f).value);moneyFlds.forEach(f=>b[f]=parseMoney(g('f_'+f).value));chkFlds.forEach(f=>b[f]=g('f_'+f).checked?1:0);return b;}
function guardar(){const id=document.getElementById('f_ID_TARIFA').value,errEl=document.getElementById('frmError');if(!id){errEl.textContent='ID es requerido.';errEl.classList.remove('d-none');return;}fetch('/tarifas/guardar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(getBody())}).then(r=>r.json()).then(d=>{if(d.error){errEl.textContent=d.error;errEl.classList.remove('d-none');return;}modal.hide();browse.load();});}
function confirmDelete(){if(!window._selectedRow)return;if(!confirm('¿Eliminar esta tarifa?'))return;fetch('/tarifas/eliminar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ID_TARIFA:window._selectedRow.ID_TARIFA})}).then(r=>r.json()).then(d=>{if(!d.error)browse.load();});}

// Lookup genérico
const lkCfg={
  origen:{url:'/tarifas/lookup/ciudades',title:'Seleccionar Ciudad Origen',heads:['ID','Ciudad'],row:r=>`<tr data-id="${r.ID_CIUDAD}" data-desc="${(r.CIUDAD||'').trim()}" style="cursor:pointer"><td>${r.ID_CIUDAD}</td><td>${(r.CIUDAD||'').trim()}</td></tr>`,onSelect:row=>{document.getElementById('f_ID_CIUDADORIGEN').value=row.dataset.id;document.getElementById('f_CDORIGEN').value=row.dataset.desc;armaDesFlete();}},
  destino:{url:'/tarifas/lookup/ciudades',title:'Seleccionar Ciudad Destino',heads:['ID','Ciudad'],row:r=>`<tr data-id="${r.ID_CIUDAD}" data-desc="${(r.CIUDAD||'').trim()}" style="cursor:pointer"><td>${r.ID_CIUDAD}</td><td>${(r.CIUDAD||'').trim()}</td></tr>`,onSelect:row=>{document.getElementById('f_ID_CIUDADDESTINO').value=row.dataset.id;document.getElementById('f_CDDESTINO').value=row.dataset.desc;armaDesFlete();}},
  tipoflete:{url:'/tarifas/lookup/tipoflete',title:'Seleccionar Tipo de Flete',heads:['ID','Flete'],row:r=>`<tr data-id="${r.ID_TIPOFLETE}" data-desc="${(r.FLETE||'').trim()}" style="cursor:pointer"><td>${r.ID_TIPOFLETE}</td><td>${(r.FLETE||'').trim()}</td></tr>`,onSelect:row=>{document.getElementById('f_ID_TIPOFLETE').value=row.dataset.id;document.getElementById('f_FLETE').value=row.dataset.desc;}},
  transport:{url:'/tarifas/lookup/transport',title:'Seleccionar Transportista',heads:['ID','Nombre'],row:r=>`<tr data-id="${r.ID_TRANSPORTISTA}" data-desc="${(r.NOMBRECOMUN||'').trim()}" style="cursor:pointer"><td>${r.ID_TRANSPORTISTA}</td><td>${(r.NOMBRECOMUN||'').trim()}</td></tr>`,onSelect:row=>{document.getElementById('f_ID_TRANSPORTISTA').value=row.dataset.id;document.getElementById('f_NOMBRECOMUNTRANS').value=row.dataset.desc;}},
  moneda:{url:'/tarifas/lookup/moneda',title:'Seleccionar Moneda (catálogo SAT)',heads:['Clave','Descripción'],row:r=>`<tr data-id="${r.clave}" style="cursor:pointer"><td>${r.clave}</td><td>${r.descripcion}</td></tr>`,onSelect:row=>{document.getElementById('f_MONVENTA').value=row.dataset.id;}},
  clientes:{url:'/tarifas/lookup/clientes',title:'Seleccionar Cliente',heads:['ID','Nombre'],row:r=>`<tr data-id="${r.ID_CLIENTE}" data-desc="${(r.NOMBRECOMUN||'').trim()}" style="cursor:pointer"><td>${r.ID_CLIENTE}</td><td>${(r.NOMBRECOMUN||'').trim()}</td></tr>`,onSelect:row=>{document.getElementById('f_ID_CLIENTE').value=row.dataset.id;document.getElementById('f_NOMBRECOMUNCLI').value=row.dataset.desc;}}
};
let lkCurrent=null,lkPage=1;
const lkGenModal=new bootstrap.Modal(document.getElementById('lookupGen'));
function openLk(type){lkCurrent=lkCfg[type];lkPage=1;document.getElementById('lkGenTitle').textContent=lkCurrent.title;document.getElementById('lkGenHead').innerHTML=lkCurrent.heads.map(h=>`<th>${h}</th>`).join('');document.getElementById('lkGenQ').value='';loadLkGen();lkGenModal.show();}
function loadLkGen(){if(!lkCurrent)return;fetch(`${lkCurrent.url}?q=${encodeURIComponent(document.getElementById('lkGenQ').value)}&page=${lkPage}`).then(r=>r.json()).then(d=>{document.getElementById('lkGenBody').innerHTML=d.rows.map(lkCurrent.row).join('');document.getElementById('lkGenInfo').textContent=`Pág ${d.page}/${d.totalPages}`;document.getElementById('lkGenPrev').disabled=d.page<=1;document.getElementById('lkGenNext').disabled=d.page>=d.totalPages;});}
document.getElementById('lkGenQ').addEventListener('input',debounce(()=>{lkPage=1;loadLkGen();},300));
document.getElementById('lkGenPrev').addEventListener('click',()=>{if(lkPage>1){lkPage--;loadLkGen();}});
document.getElementById('lkGenNext').addEventListener('click',()=>{lkPage++;loadLkGen();});
document.getElementById('lkGenBody').addEventListener('click',e=>{const row=e.target.closest('tr[data-id]');if(!row||!lkCurrent)return;lkCurrent.onSelect(row);lkGenModal.hide();});
</script>
