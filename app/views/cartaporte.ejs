<%- include('partials/header', { titulo: 'Carta Porte' }) %>
<%- include('partials/sidebar') %>
<div id="page-content">
  <div class="d-flex align-items-center mb-3">
    <button class="btn btn-sm btn-outline-secondary me-3 d-md-none" id="sidebarToggle"><i class="bi bi-list fs-5"></i></button>
    <h4 class="mb-0 fw-bold flex-grow-1">Carta Porte</h4>
    <span class="badge bg-success ms-2">Central: <strong><%= central || '—' %></strong></span>
    <span class="badge bg-warning text-dark ms-1">Año: <strong><%= anio %></strong></span>
  </div>

  <!-- Search + Buttons -->
  <div class="card border-0 shadow-sm mb-3 barra-filtros">
    <div class="card-body py-2">
      <div class="row align-items-center g-2">
        <div class="col-auto">
          <select id="searchCol" class="form-select form-select-sm">
            <option value="NombreComunCli">Cliente</option>
            <option value="CartaPorte" selected>Carta Porte</option>
            <option value="DesFlete">Descripción flete</option>
            <option value="Status">Status</option>
            <option value="RealizoPedido">Realizó</option>
          </select>
        </div>
        <div class="col col-md-4">
          <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Buscar...">
        </div>
        <div class="col-auto ms-auto btn-action-group">
          <button class="btn btn-sm btn-primary" id="btnEditar" data-requires-selection disabled onclick="openEdit()"><i class="bi bi-pencil"></i> Editar</button>
          <button class="btn btn-sm btn-outline-primary" data-requires-selection disabled onclick="openVisualizar()"><i class="bi bi-eye"></i> Visualizar</button>
          <button class="btn btn-sm btn-warning" id="btnTimbrar" disabled onclick="openTimbrar()"><i class="bi bi-file-earmark-check"></i> Timbrar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
          <thead class="thead-tlc">
            <tr>
              <th data-sort="Serie" style="width:70px">Serie <span class="sort-icon"></span></th>
              <th data-sort="CartaPorte" style="width:120px">Carta Porte <span class="sort-icon"></span></th>
              <th data-sort="FechaPedido" style="width:105px">F. Pedido <span class="sort-icon"></span></th>
              <th data-sort="FehcaCarga" style="width:105px">F. Carga <span class="sort-icon"></span></th>
              <th data-sort="NombreComunCli">Cliente <span class="sort-icon"></span></th>
              <th data-sort="DesFlete">Descripción flete <span class="sort-icon"></span></th>
              <th data-sort="Status" style="width:100px">Status <span class="sort-icon"></span></th>
              <th data-sort="RealizoPedido" style="width:110px">Realizó <span class="sort-icon"></span></th>
            </tr>
          </thead>
          <tbody id="tableBody"></tbody>
        </table>
      </div>
    </div>
    <div class="card-footer bg-white d-flex align-items-center justify-content-between py-2">
      <span class="page-info" id="pageInfo"></span>
      <div id="pagination">
        <button class="btn btn-sm btn-outline-secondary" data-action="prev"><i class="bi bi-chevron-left"></i> Anterior</button>
        <button class="btn btn-sm btn-outline-secondary" data-action="next">Siguiente <i class="bi bi-chevron-right"></i></button>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════ MODAL PRINCIPAL ═══════════════════════════════════════ -->
<div class="modal fade" id="frmModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="frmTitle">Carta Porte</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="frmError" class="alert alert-danger d-none py-2 small"></div>
        <ul class="nav nav-tabs mb-3" id="cpTabs" role="tablist">
          <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabCP">Carta Porte</a></li>
          <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabMerc" id="tabMercLink">Mercancías</a></li>
          <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabDepo" id="tabDepoLink">Depósitos</a></li>
          <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabCostos">Costos</a></li>
        </ul>
        <div class="tab-content">

          <!-- ── TAB 1: CARTA PORTE ─────────────────────────────────────── -->
          <div class="tab-pane fade show active" id="tabCP">
            <!-- Fila 1 -->
            <div class="row g-2 mb-2">
              <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Serie</label>
                <input type="text" id="f_Serie" class="form-control form-control-sm" readonly>
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">Carta Porte</label>
                <input type="text" id="f_CartaPorte" class="form-control form-control-sm" readonly>
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">Fecha pedido</label>
                <input type="date" id="f_FechaPedido" class="form-control form-control-sm" readonly>
              </div>
              <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Status</label>
                <input type="text" id="f_Status" class="form-control form-control-sm" maxlength="20">
              </div>
              <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1">Realizó</label>
                <input type="text" id="f_RealizoPedido" class="form-control form-control-sm" readonly>
              </div>
            </div>
            <!-- Fila 2 -->
            <div class="row g-2 mb-2">
              <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">F. Carga <span class="text-danger">*</span></label>
                <input type="date" id="f_FehcaCarga" class="form-control form-control-sm">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">Hora carga</label>
                <input type="time" id="f_HoraCarga" class="form-control form-control-sm">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">F. Descarga <span class="text-danger">*</span></label>
                <input type="date" id="f_FechaDesCarta" class="form-control form-control-sm">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1">Hora descarga</label>
                <input type="time" id="f_HorarioDesCarta" class="form-control form-control-sm">
              </div>
            </div>
            <!-- Fila 2b -->
            <div class="row g-2 mb-2">
              <div class="col-md-4">
                <label class="form-label fw-semibold small mb-1">Booking</label>
                <input type="text" id="f_Booking" class="form-control form-control-sm" maxlength="20">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold small mb-1">Doc. Relacionado</label>
                <input type="text" id="f_NoRainde" class="form-control form-control-sm" maxlength="20">
              </div>
            </div>
            <!-- Fila 3: Clientes -->
            <div class="row g-2 mb-2">
              <div class="col-md-4">
                <label class="form-label fw-semibold small mb-1">Cliente <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm">
                  <input type="hidden" id="f_Id_Cliente">
                  <input type="text" id="f_NombreComunCli" class="form-control form-control-sm" readonly placeholder="Seleccionar...">
                  <button class="btn btn-outline-secondary" type="button" id="btnLkCliente" onclick="openLkCliente('principal')"><i class="bi bi-search"></i></button>
                  <button class="btn btn-outline-danger btn-sm" type="button" id="btnClearCliente" onclick="clearCliente()" title="Limpiar"><i class="bi bi-x"></i></button>
                </div>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold small mb-1">Cliente entrega</label>
                <div class="input-group input-group-sm">
                  <input type="hidden" id="f_Id_ClienteEnt">
                  <input type="text" id="f_ClienteEnt" class="form-control form-control-sm" readonly placeholder="Seleccionar...">
                  <button class="btn btn-outline-secondary" type="button" id="btnLkClienteEnt" onclick="openLkCliente('ent')"><i class="bi bi-search"></i></button>
                </div>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold small mb-1">Cliente carga</label>
                <div class="input-group input-group-sm">
                  <input type="hidden" id="f_Id_ClienteCarga">
                  <input type="text" id="f_ClienteCarga" class="form-control form-control-sm" readonly placeholder="Seleccionar...">
                  <button class="btn btn-outline-secondary" type="button" id="btnLkClienteCarga" onclick="openLkCliente('carga')"><i class="bi bi-search"></i></button>
                </div>
              </div>
            </div>
            <!-- Lookups dependientes del cliente -->
            <div id="seccionDependienteCliente" style="display:none">
              <!-- Fila 5: Tarifa -->
              <div class="row g-2 mb-2">
                <div class="col-md-5">
                  <label class="form-label fw-semibold small mb-1">Tarifa / Descripción flete <span class="text-danger">*</span></label>
                  <div class="input-group input-group-sm">
                    <input type="hidden" id="f_Id_Tarifa">
                    <input type="text" id="f_DesFlete" class="form-control form-control-sm" readonly placeholder="Seleccionar tarifa...">
                    <button class="btn btn-outline-secondary" type="button" id="btnLkTarifa" onclick="openLkTarifa()"><i class="bi bi-search"></i></button>
                  </div>
                </div>
              </div>
              <!-- Fila 6: Camion + Operador -->
              <div class="row g-2 mb-2">
                <div class="col-md-4">
                  <label class="form-label fw-semibold small mb-1">Camión <span class="text-danger">*</span></label>
                  <div class="input-group input-group-sm">
                    <input type="hidden" id="f_Id_Camion">
                    <input type="text" id="f_NoCamion" class="form-control form-control-sm" readonly placeholder="Seleccionar...">
                    <button class="btn btn-outline-secondary" type="button" onclick="openLkCamion()"><i class="bi bi-search"></i></button>
                  </div>
                </div>
                <div class="col-md-2">
                  <label class="form-label fw-semibold small mb-1">Placas</label>
                  <input type="text" id="f_NoPlacas" class="form-control form-control-sm" readonly>
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-semibold small mb-1">Caja 1 <span class="text-danger">*</span></label>
                  <div class="input-group input-group-sm">
                    <input type="text" id="f_NoCaja" class="form-control form-control-sm" readonly placeholder="Seleccionar...">
                    <button class="btn btn-outline-secondary" type="button" onclick="openLkRemolque('caja1')"><i class="bi bi-search"></i></button>
                  </div>
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-semibold small mb-1">Caja 2</label>
                  <div class="input-group input-group-sm">
                    <input type="text" id="f_NoCaja2" class="form-control form-control-sm" readonly placeholder="Seleccionar...">
                    <button class="btn btn-outline-secondary" type="button" onclick="openLkRemolque('caja2')"><i class="bi bi-search"></i></button>
                  </div>
                </div>
              </div>
              <!-- Fila 7: Operador -->
              <div class="row g-2 mb-2">
                <div class="col-md-4">
                  <label class="form-label fw-semibold small mb-1">Operador <span class="text-danger">*</span></label>
                  <div class="input-group input-group-sm">
                    <input type="hidden" id="f_Id_Operador">
                    <input type="text" id="f_Operador" class="form-control form-control-sm" readonly placeholder="Seleccionar...">
                    <button class="btn btn-outline-secondary" type="button" onclick="openLkOperador()"><i class="bi bi-search"></i></button>
                  </div>
                </div>
              </div>
              <!-- Fila 8: Domicilios -->
              <div class="row g-2 mb-2">
                <div class="col-md-6">
                  <label class="form-label fw-semibold small mb-1">Dom. carga <span class="text-danger">*</span></label>
                  <div class="input-group input-group-sm">
                    <input type="hidden" id="f_Id_DomCarga">
                    <input type="text" id="f_DomCarga" class="form-control form-control-sm" readonly placeholder="Seleccionar...">
                    <button class="btn btn-outline-secondary" type="button" id="btnLkDomCarga" onclick="openLkDom('carga')"><i class="bi bi-search"></i></button>
                  </div>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold small mb-1">Dom. descarga <span class="text-danger">*</span></label>
                  <div class="input-group input-group-sm">
                    <input type="hidden" id="f_Id_DomDescarga1">
                    <input type="text" id="f_DomDescarga" class="form-control form-control-sm" readonly placeholder="Seleccionar...">
                    <button class="btn btn-outline-secondary" type="button" id="btnLkDomDescarga" onclick="openLkDom('descarga')"><i class="bi bi-search"></i></button>
                  </div>
                </div>
              </div>
            </div><!-- /seccionDependienteCliente -->

            <!-- Observaciones -->
            <div class="row g-2 mb-2">
              <div class="col-12">
                <label class="form-label fw-semibold small mb-1">Observaciones</label>
                <textarea id="f_Observaciones" class="form-control form-control-sm" rows="2" maxlength="255"></textarea>
              </div>
            </div>
          </div><!-- /tabCP -->

          <!-- ── TAB 2: MERCANCÍAS ──────────────────────────────────────── -->
          <div class="tab-pane fade" id="tabMerc">
            <div class="d-flex justify-content-end mb-2">
              <button class="btn btn-sm btn-success" onclick="openAddMerc()"><i class="bi bi-plus-lg"></i> Agregar mercancía</button>
            </div>
            <div class="table-responsive">
              <table class="table table-hover table-sm mb-0">
                <thead class="thead-tlc">
                  <tr>
                    <th style="width:50px">#</th>
                    <th>SKU</th>
                    <th>Descripción</th>
                    <th style="width:80px">Cantidad</th>
                    <th style="width:90px">Clave Unidad</th>
                    <th style="width:90px">Peso (kg)</th>
                    <th style="width:110px">Valor</th>
                    <th style="width:60px"></th>
                  </tr>
                </thead>
                <tbody id="mercBody"></tbody>
              </table>
            </div>
            <div class="row g-3 align-items-end mt-2 pt-2 border-top">
              <div class="col-auto">
                <label class="form-label fw-semibold small mb-1">Total mercancías</label>
                <input type="text" id="f_TotalMercancias" class="form-control form-control-sm bg-light" style="width:100px" readonly tabindex="-1">
              </div>
              <div class="col-auto">
                <label class="form-label fw-semibold small mb-1">Peso bruto total (kg)</label>
                <input type="text" id="f_PesoBrutoTotal" class="form-control form-control-sm bg-light" style="width:150px" readonly tabindex="-1">
              </div>
              <div class="col-auto">
                <label class="form-label fw-semibold small mb-1">Unidad peso</label>
                <input type="text" id="f_UnidadPeso" class="form-control form-control-sm" style="width:90px" maxlength="10">
              </div>
            </div>
          </div><!-- /tabMerc -->

          <!-- ── TAB 3: DEPÓSITOS ───────────────────────────────────────── -->
          <div class="tab-pane fade" id="tabDepo">
            <div class="d-flex justify-content-end mb-2">
              <button class="btn btn-sm btn-success" onclick="openAddDepo()"><i class="bi bi-plus-lg"></i> Agregar depósito</button>
            </div>
            <div class="table-responsive">
              <table class="table table-hover table-sm mb-0">
                <thead class="thead-tlc">
                  <tr>
                    <th style="min-width:110px">Fecha</th>
                    <th style="min-width:110px">Pensión</th>
                    <th style="min-width:110px">Casetas</th>
                    <th style="min-width:110px">Maniobra</th>
                    <th style="min-width:110px">Estadías</th>
                    <th style="min-width:110px">Otros</th>
                    <th style="min-width:120px">Monto</th>
                    <th style="min-width:110px">Préstamo</th>
                    <th style="min-width:110px">Talachas</th>
                    <th style="min-width:110px">Llantas</th>
                    <th style="min-width:110px">Diesel</th>
                    <th style="min-width:110px">Comidas</th>
                    <th style="min-width:110px">Báscula</th>
                    <th style="min-width:110px">Refacciones</th>
                    <th style="min-width:160px">Realizó</th>
                    <th style="min-width:70px"></th>
                  </tr>
                </thead>
                <tbody id="depoBody"></tbody>
              </table>
            </div>
          </div><!-- /tabDepo -->

          <!-- ── TAB 4: COSTOS ──────────────────────────────────────────── -->
          <div class="tab-pane fade" id="tabCostos">
            <div class="row g-3">

              <div class="col-12"><h6 class="text-primary fw-bold border-bottom pb-1 mb-1">Costos de venta</h6></div>

              <div class="col-6">
                <label class="form-label fw-semibold small mb-1">Flete</label>
                <input type="number" id="f_CostoFlete" class="form-control form-control-sm bg-light" step="0.01" readonly>
              </div>
              <div class="col-6">
                <label class="form-label fw-semibold small mb-1">Renta</label>
                <input type="number" id="f_CostoDemoras" class="form-control form-control-sm bg-light" step="0.01" readonly>
              </div>
              <div class="col-6">
                <label class="form-label fw-semibold small mb-1">Costo kilómetros</label>
                <input type="number" id="f_Kilometros" class="form-control form-control-sm bg-light" step="0.01" readonly>
              </div>
              <div class="col-6">
                <label class="form-label fw-semibold small mb-1">Km tarifa</label>
                <input type="number" id="f_KilometrosTar" class="form-control form-control-sm bg-light" readonly>
              </div>
              <div class="col-6">
                <label class="form-label fw-semibold small mb-1">Retención/km</label>
                <input type="number" id="f_RetenKilo" class="form-control form-control-sm bg-light" step="0.01" readonly>
              </div>
              <div class="col-6">
                <label class="form-label fw-semibold small mb-1">Moneda</label>
                <input type="text" id="f_c_Moneda" class="form-control form-control-sm bg-light" maxlength="10" readonly>
              </div>
              <div class="col-6">
                <label class="form-label fw-semibold small mb-1">Tipo cambio</label>
                <input type="number" id="f_TipoCambio" class="form-control form-control-sm bg-light" step="0.01" readonly>
              </div>

              <div class="col-12"><h6 class="text-primary fw-bold border-bottom pb-1 mb-1 mt-1">Totales MXN</h6></div>

              <div class="col-6">
                <label class="form-label fw-semibold small mb-1">SubTotal MX</label>
                <input type="number" id="f_SubTotalMX" class="form-control form-control-sm bg-light" readonly>
              </div>
              <div class="col-6">
                <label class="form-label fw-semibold small mb-1">IVA MX (16%)</label>
                <input type="number" id="f_IVAMX" class="form-control form-control-sm bg-light" readonly>
              </div>
              <div class="col-6">
                <label class="form-label fw-semibold small mb-1">Retención MX (4%)</label>
                <input type="number" id="f_RetenMX" class="form-control form-control-sm bg-light" readonly>
              </div>
              <div class="col-6">
                <label class="form-label fw-semibold small mb-1 text-primary fw-bold">TOTAL MX</label>
                <input type="number" id="f_TOTALMX" class="form-control form-control-sm bg-primary bg-opacity-10 fw-bold" readonly>
              </div>

            </div>

            <!-- Campos ocultos para compatibilidad con BD -->
            <div style="display:none">
              <input type="number" id="f_PorIVAMX" value="16">
              <input type="number" id="f_CostoManiobras">
              <input type="number" id="f_CostoAutopistas">
              <input type="number" id="f_CostoDobOpe">
              <input type="number" id="f_CostoDisel">
              <input type="number" id="f_NoParadas">
              <input type="number" id="f_CostoParada">
              <input type="number" id="f_CostosOtros">
              <input type="text"   id="f_DesOtrosCostos">
              <input type="number" id="f_CargoExtraTrans">
              <input type="checkbox" id="f_FlagCobMan">
              <input type="checkbox" id="f_FlagCobDem">
              <input type="checkbox" id="f_FlagCobAuto">
              <input type="checkbox" id="f_FlagCobDO">
              <input type="checkbox" id="f_FlagConDis">
              <input type="checkbox" id="f_FlagCobParada">
              <input type="checkbox" id="f_FlagCobOtros">
              <input type="checkbox" id="f_FlagCobCE">
              <input type="checkbox" id="f_FlagIVA">
              <input type="checkbox" id="f_FlagRet">
              <input type="number" id="f_CostoPrestamo">
              <input type="number" id="f_CostoTalacha">
              <input type="number" id="f_CostoCompllanta">
              <input type="number" id="f_CostoDiesel">
              <input type="number" id="f_CostoCasetas">
              <input type="number" id="f_CostoComidas">
              <input type="number" id="f_CostoManiobrasExt">
              <input type="number" id="f_CostoBascula">
              <input type="number" id="f_CostoPension">
              <input type="number" id="f_CostoRefacciones">
              <input type="number" id="f_CostoOtros">
            </div>
          </div><!-- /tabCostos -->

        </div><!-- /tab-content -->
      </div><!-- /modal-body -->
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i> Cerrar</button>
        <button class="btn btn-primary" id="btnGuardar" onclick="guardar()"><i class="bi bi-floppy"></i> Guardar</button>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════ MODAL MERCANCÍA ══════════════════════════════════════ -->
<div class="modal fade" id="mercModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h6 class="modal-title" id="mercTitle">Mercancía</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div id="mercError" class="alert alert-danger d-none py-2 small"></div>
        <div class="row g-2">
          <div class="col-md-3"><label class="form-label fw-semibold small mb-1">SKU</label><input type="text" id="m_SKU" class="form-control form-control-sm" maxlength="25"></div>
          <div class="col-md-3">
            <label class="form-label fw-semibold small mb-1">Bienes transp.</label>
            <div class="input-group input-group-sm">
