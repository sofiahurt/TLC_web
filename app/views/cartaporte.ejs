// ── MERCANCIAS ────────────────────────────────────────────────────────────────
function loadMercancias(serie, cp) {
  fetch(`/cartaporte/mercancias?serie=${encodeURIComponent(serie)}&cartaporte=${encodeURIComponent(cp)}`)
    .then(r => r.json())
    .then(rows => {
      const body = document.getElementById('mercBody');
      body.innerHTML = rows.map(r =>
        `<tr ${_statusLocked ? '' : `ondblclick="editMerc(${r.Id_Mercancia})"`}>
          <td>${r.Id_Mercancia}</td>
          <td>${r.SKU||''}</td>
          <td>${r.Descripcion||''}</td>
          <td>${r.Cantidad||''}</td>
          <td>${r.ClaveUnidad||''}</td>
          <td>${r.PesoEnKg||''}</td>
          <td>${r.ValorMercancia||''}</td>
          <td class="text-center">${_statusLocked ? '' :
            `<button class="btn btn-xs btn-sm btn-outline-primary py-0 px-1" onclick="editMerc(${r.Id_Mercancia})"><i class="bi bi-pencil"></i></button>
             <button class="btn btn-xs btn-sm btn-outline-danger py-0 px-1" onclick="delMerc(${r.Id_Mercancia})"><i class="bi bi-trash"></i></button>`
          }</td>
        </tr>`
      ).join('') || '<tr><td colspan="8" class="text-center text-muted small">Sin registros</td></tr>';
      recalcTotalesMerc(rows);
    });
}

function recalcTotalesMerc(rows) {
  document.getElementById('f_TotalMercancias').value = rows.length || '';
  const pesoBruto = rows.reduce((s, r) => s + (parseFloat(r.PesoEnKg) || 0), 0);
  document.getElementById('f_PesoBrutoTotal').value = pesoBruto ? pesoBruto.toFixed(3) : '';
}

function calcPesoKg() {
  const cant = parseFloat(document.getElementById('m_Cantidad').value) || 0;
  const peso = parseFloat(document.getElementById('m_PesoUnidad').value) || 0;
  document.getElementById('m_PesoEnKg').value = cant && peso ? (cant * peso).toFixed(3) : '';
}

function toggleMatPel() {
  const show = document.getElementById('m_MaterialPeligroso').value === 'Si';
  document.getElementById('seccionMatPel').classList.toggle('d-none', !show);
  if (!show) {
    document.getElementById('m_CveMaterialPeligroso').value = '';
    document.getElementById('m_cve_Embalaje').value = '';
    document.getElementById('m_DescripEmbalaje').value = '';
  }
}

function openAddMerc() {
  _mercMode = 'add'; _mercEditId = null;
  document.getElementById('mercTitle').textContent = 'Nueva Mercancía';
  document.querySelectorAll('#mercModal input, #mercModal select').forEach(el => { if (el.type === 'checkbox') el.checked = false; else el.value = ''; });
  document.getElementById('m_MaterialPeligroso').value = 'No';
  document.getElementById('m_Moneda').value = 'MXN';
  toggleMatPel();
  mercModal.show();
}

function editMerc(id) {
  _mercMode = 'edit'; _mercEditId = id;
  fetch(`/cartaporte/mercancias?serie=${encodeURIComponent(_currentSerie)}&cartaporte=${encodeURIComponent(_currentCP)}`)
    .then(r => r.json()).then(rows => {
      const r = rows.find(x => x.Id_Mercancia == id);
      if (!r) return;
      document.getElementById('mercTitle').textContent = 'Editar Mercancía';
      ['SKU','BienesTransp','Descripcion','DesManual','Cantidad','ClaveUnidad','Unidad',
       'PesoUnidad','MaterialPeligroso','CveMaterialPeligroso','cve_Embalaje',
       'DescripEmbalaje','PesoEnKg','ValorMercancia','Moneda'
      ].forEach(k => { const el = document.getElementById('m_'+k); if (el) el.value = r[k]??''; });
      toggleMatPel();
      mercModal.show();
    });
}

function delMerc(id) {
  if (!confirm('¿Eliminar mercancía?')) return;
  fetch('/cartaporte/mercancias/eliminar', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ Serie: _currentSerie, CartaPorte: _currentCP, Id_Mercancia: id })
  }).then(r => r.json()).then(() => loadMercancias(_currentSerie, _currentCP));
}

function guardarMerc() {
  const v = id => document.getElementById(id)?.value ?? '';
  const errEl = document.getElementById('mercError');
  errEl.classList.add('d-none');
  const missing = [['m_BienesTransp','Bienes transportados'],['m_ClaveUnidad','Clave unidad'],['m_Cantidad','Cantidad']]
    .filter(([id]) => !v(id).trim()).map(([,lbl]) => lbl);
  if (missing.length) { errEl.textContent = `Campos obligatorios: ${missing.join(', ')}`; errEl.classList.remove('d-none'); return; }
  const payload = {
    _mode: _mercMode, Serie: _currentSerie, CartaPorte: _currentCP,
    Id_Mercancia: _mercEditId,
    SKU: v('m_SKU'), BienesTransp: v('m_BienesTransp'), Descripcion: v('m_Descripcion'),
    DesManual: v('m_DesManual'), Cantidad: v('m_Cantidad'), ClaveUnidad: v('m_ClaveUnidad'),
    Unidad: v('m_Unidad'), PesoUnidad: v('m_PesoUnidad'),
    MaterialPeligroso: v('m_MaterialPeligroso'), CveMaterialPeligroso: v('m_CveMaterialPeligroso'),
    cve_Embalaje: v('m_cve_Embalaje'), DescripEmbalaje: v('m_DescripEmbalaje'),
    PesoEnKg: v('m_PesoEnKg'), ValorMercancia: v('m_ValorMercancia'), Moneda: v('m_Moneda')
  };
  fetch('/cartaporte/mercancias/guardar', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  }).then(r => r.json()).then(d => {
    if (d.error) { document.getElementById('mercError').textContent = d.error; document.getElementById('mercError').classList.remove('d-none'); return; }
    mercModal.hide();
    loadMercancias(_currentSerie, _currentCP);
  });
}

// ── DEPOSITOS (Solicitud de Depósito por Viaje) ────────────────────────────────
const DEPO_IMPORTE_IDS = ['d_Prestamo','d_Talachas','d_Llantas','d_Diesel','d_Comidas','d_Pension','d_Bascula','d_Casetas','d_Refacciones','d_Maniobra','d_Otros','d_Estadias'];

function recalcularMontoDepo() {
  const total = DEPO_IMPORTE_IDS.reduce((acc, id) => acc + (parseFloat(document.getElementById(id).value) || 0), 0);
  document.getElementById('d_Monto').value = total.toFixed(2);
}

function loadDepositos(serie, cp) {
  fetch(`/cartaporte/depositos?serie=${encodeURIComponent(serie)}&cartaporte=${encodeURIComponent(cp)}`)
    .then(r => r.json())
    .then(rows => {
      const body = document.getElementById('depoBody');
      const fmt  = v => v ? v.toString().slice(0,10) : '';
      const imp  = v => v ? parseFloat(v).toFixed(2) : '';
      body.innerHTML = rows.map(r =>
        `<tr ondblclick="editDepo(${r.Id_DepoSol})">
          <td>${fmt(r.Fecha)}</td>
          <td>${imp(r.Pension)}</td>
          <td>${imp(r.Casetas)}</td>
          <td>${imp(r.Maniobra)}</td>
          <td>${imp(r.Estadias)}</td>
          <td>${imp(r.Otros)}</td>
          <td class="fw-bold">${imp(r.Monto)}</td>
          <td>${imp(r.Prestamo)}</td>
          <td>${imp(r.Talachas)}</td>
          <td>${imp(r.Llantas)}</td>
          <td>${imp(r.Diesel)}</td>
          <td>${imp(r.Comidas)}</td>
          <td>${imp(r.Bascula)}</td>
          <td>${imp(r.Refacciones)}</td>
          <td>${r.WhoCaptura||''}</td>
          <td class="text-center">
            <button class="btn btn-sm btn-outline-primary py-0 px-1" onclick="editDepo(${r.Id_DepoSol})"><i class="bi bi-pencil"></i></button>
            <button class="btn btn-sm btn-outline-danger py-0 px-1" onclick="delDepo(${r.Id_DepoSol})"><i class="bi bi-trash"></i></button>
          </td>
        </tr>`
      ).join('') || '<tr><td colspan="16" class="text-center text-muted small">Sin registros</td></tr>';
    });
}

function openAddDepo() {
  if (!_currentCP) { alert('Debe guardar primero el Pedido/Viaje antes de capturar una solicitud de depósito.'); return; }
  _depoMode = 'add'; _depoEditId = null;
  document.getElementById('depoTitle').textContent = 'Solicitud de Depósito por Viaje';
  document.querySelectorAll('#depoModal input, #depoModal textarea').forEach(el => el.value = '');
  document.getElementById('depoError').classList.add('d-none');

  // Precarga desde el Pedido/Viaje activo (todo solo lectura)
  const now = new Date();
  document.getElementById('d_Fecha').value = today;
  document.getElementById('d_Hora').value  = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
  document.getElementById('d_Serie').value = _currentSerie;
  document.getElementById('d_CartaPorte').value = _currentCP;
  document.getElementById('d_Id_Operador').value = document.getElementById('f_Id_Operador').value;
  document.getElementById('d_OPERADOR').value    = document.getElementById('f_Operador').value;
  document.getElementById('d_TC').value          = document.getElementById('f_NoCamion').value;
  document.getElementById('d_Origen').value      = document.getElementById('f_DomCarga').value;
  document.getElementById('d_Destino').value     = document.getElementById('f_DomDescarga').value;
  document.getElementById('d_Turno').value = 'Mañana';
  recalcularMontoDepo();
  depoModal.show();
}

function editDepo(id) {
  _depoMode = 'edit'; _depoEditId = id;
  fetch(`/cartaporte/depositos?serie=${encodeURIComponent(_currentSerie)}&cartaporte=${encodeURIComponent(_currentCP)}`)
    .then(r => r.json()).then(rows => {
      const r = rows.find(x => x.Id_DepoSol == id);
      if (!r) return;
      document.getElementById('depoTitle').textContent = 'Solicitud de Depósito por Viaje';
      document.getElementById('depoError').classList.add('d-none');
      const fmt   = v => v ? v.toString().slice(0,10) : '';
      const fmtHM = v => { if (!v) return ''; const d = new Date(v); return `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`; };
      const chk   = (id, val) => { document.getElementById(id).checked = !!parseInt(val); };
      document.getElementById('d_Fecha').value = fmt(r.Fecha);
      document.getElementById('d_Hora').value  = fmtHM(r.Hora);
      document.getElementById('d_Serie').value = r.Serie||'';
      document.getElementById('d_CartaPorte').value = r.CartaPorte||'';
      document.getElementById('d_Id_Operador').value = r.ID_OPERADOR||'';
      document.getElementById('d_TC').value = r.TC||'';
      ['Turno','OPERADOR','Grupo','Origen','Destino','Prestamo',
       'Talachas','Llantas','Diesel','Casetas','Comidas','Maniobra','Bascula',
       'Pension','Refacciones','Otros','Estadias','DesOtros','Observaciones'
      ].forEach(k => { const el = document.getElementById('d_'+k); if (el) el.value = r[k]??''; });
      chk('d_FlagCobCaseta', r.FlagCobCaseta);
      chk('d_FlagCobMan',    r.FlagCobMan);
      chk('d_FlagCobPen',    r.FlagCobPen);
      chk('d_FlagCobEsta',   r.FlagCobEsta);
      chk('d_FlagCobOtros',  r.FlagCobOtros);
      recalcularMontoDepo();
      depoModal.show();
    });
}

function delDepo(id) {
  if (!confirm('¿Eliminar depósito?')) return;
  fetch('/cartaporte/depositos/eliminar', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ Id_DepoSol: id })
  }).then(r => r.json()).then(() => loadDepositos(_currentSerie, _currentCP));
}

function guardarDepo() {
  const v = id => document.getElementById(id)?.value ?? '';
  const c = id => document.getElementById(id)?.checked ? 1 : 0;
  const payload = {
    _mode: _depoMode, Id_DepoSol: _depoEditId,
    Serie: v('d_Serie'), CartaPorte: v('d_CartaPorte'),
    Fecha: v('d_Fecha'), Hora: v('d_Hora'), Turno: v('d_Turno'), Grupo: v('d_Grupo'),
    ID_OPERADOR: v('d_Id_Operador'), OPERADOR: v('d_OPERADOR'), TC: v('d_TC'),
    Origen: v('d_Origen'), Destino: v('d_Destino'),
    Prestamo: v('d_Prestamo'), Talachas: v('d_Talachas'), Llantas: v('d_Llantas'),
    Diesel: v('d_Diesel'), Casetas: v('d_Casetas'), Comidas: v('d_Comidas'),
    Maniobra: v('d_Maniobra'), Bascula: v('d_Bascula'), Pension: v('d_Pension'),
    Refacciones: v('d_Refacciones'), Otros: v('d_Otros'), Estadias: v('d_Estadias'),
    DesOtros: v('d_DesOtros'), Observaciones: v('d_Observaciones'),
    FlagCobCaseta: c('d_FlagCobCaseta'), FlagCobMan: c('d_FlagCobMan'),
    FlagCobPen: c('d_FlagCobPen'), FlagCobEsta: c('d_FlagCobEsta'), FlagCobOtros: c('d_FlagCobOtros')
  };
  fetch('/cartaporte/depositos/guardar', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  }).then(r => r.json()).then(d => {
    if (d.error) { document.getElementById('depoError').textContent = d.error; document.getElementById('depoError').classList.remove('d-none'); return; }
    depoModal.hide();
    loadDepositos(_currentSerie, _currentCP);
  });
}

// ── LOOKUP GENÉRICO ───────────────────────────────────────────────────────────
let _lkUrl = '', _lkPage = 1, _lkOnSelect = null, _lkDebounce = null, _lkHeaders = [], _lkExtraParams = {};

function openGenericLookup(title, headers, url, extraParams, onSelect) {
  _lkUrl = url; _lkPage = 1; _lkOnSelect = onSelect; _lkExtraParams = extraParams || {}; _lkHeaders = headers;
  document.getElementById('lkTitle').textContent = title;
  document.getElementById('lkSearch').value = '';
  const thead = document.getElementById('lkThead').querySelector('tr');
  thead.innerHTML = headers.map(h => `<th>${h}</th>`).join('');
  lkLoadPage();
  lkModal.show();
}

function lkLoadPage() {
  const q = document.getElementById('lkSearch').value;
  const extra = Object.entries(_lkExtraParams).map(([k,v]) => `&${k}=${encodeURIComponent(v)}`).join('');
  fetch(`${_lkUrl}?q=${encodeURIComponent(q)}&page=${_lkPage}${extra}`)
    .then(r => r.json())
    .then(d => {
      document.getElementById('lkBody').innerHTML = (d.rows || []).map(r =>
        `<tr style="cursor:pointer" onclick="lkSelect(this)" data-row='${JSON.stringify(r)}'>
          ${Object.values(r).slice(0, _lkHeaders.length).map(v => `<td>${v??''}</td>`).join('')}
        </tr>`
      ).join('') || '<tr><td colspan="10" class="text-center text-muted small">Sin resultados</td></tr>';
      document.getElementById('lkInfo').textContent = `Pág ${d.page} de ${d.totalPages} — ${d.total} reg.`;
      document.getElementById('lkPrev').disabled = d.page <= 1;
      document.getElementById('lkNext').disabled = d.page >= d.totalPages;
    });
}

document.getElementById('lkSearch').addEventListener('input', () => {
  clearTimeout(_lkDebounce);
  _lkDebounce = setTimeout(() => { _lkPage = 1; lkLoadPage(); }, 300);
});
document.getElementById('lkPrev').addEventListener('click', () => { if (_lkPage > 1) { _lkPage--; lkLoadPage(); } });
document.getElementById('lkNext').addEventListener('click', () => { _lkPage++; lkLoadPage(); });

function lkSelect(tr) {
  const row = JSON.parse(tr.dataset.row);
  lkModal.hide();
  if (_lkOnSelect) _lkOnSelect(row);
}

// ── LOOKUPS ESPECÍFICOS ───────────────────────────────────────────────────────
function openLkCliente(target) {
  openGenericLookup('Buscar cliente', ['ID','Nombre','RFC'],
    '/cartaporte/lookup/clientes', {}, row => {
      if (target === 'principal') {
        document.getElementById('f_Id_Cliente').value = row.ID_CLIENTE;
        document.getElementById('f_NombreComunCli').value = (row.NOMBRECOMUN||'').trim();
        _currentIdCliente = String(row.ID_CLIENTE);
        // limpiar domicilios al cambiar cliente
        ['f_Id_DomCarga','f_DomCarga','f_Id_DomDescarga1','f_DomDescarga'].forEach(id => {
          const el = document.getElementById(id); if (el) el.value = '';
        });
        toggleSeccionCliente();
      } else if (target === 'ent') {
        document.getElementById('f_Id_ClienteEnt').value = row.ID_CLIENTE;
        document.getElementById('f_ClienteEnt').value = (row.NOMBRECOMUN||'').trim();
      } else {
        document.getElementById('f_Id_ClienteCarga').value = row.ID_CLIENTE;
        document.getElementById('f_ClienteCarga').value = (row.NOMBRECOMUN||'').trim();
      }
    });
}

function openLkTarifa() {
  openGenericLookup('Buscar tarifa', ['ID','Descripción','Tipo','Venta'],
    '/cartaporte/lookup/tarifas', { idCliente: _currentIdCliente }, row => {
      const flete = (row.FLETE||'').trim().toLowerCase();
      const renta = parseFloat(row.RENTA) || 0;
      const venta = parseFloat(row.VENTA) || 0;
      const cKm   = parseFloat(row.COSTOKILOMTS) || 0;
      const cAuto = parseFloat(row.COSTOAUTOPISTAS) || 0;
      const km    = parseFloat(row.KILOMETROS) || 0;

      let cFlete = 0, cDem = 0, kmTar = 0, kmVal = 0, autoVal = 0;
      let valid = false;

      if ((flete === 'flete' || flete === 'caseta') && renta !== 0) {
        cFlete = renta; _tarifaTipo = 'flete'; kmTar = km; kmVal = cKm; autoVal = cAuto; valid = true;
      } else if (flete === 'renta' && renta !== 0) {
        cDem = renta; _tarifaTipo = 'renta'; kmTar = km; kmVal = cKm; autoVal = cAuto; valid = true;
      } else if (cKm !== 0 || cAuto !== 0) {
        _tarifaTipo = 'km'; kmTar = km; kmVal = cKm; autoVal = cAuto; valid = true;
      } else if (venta !== 0) {
        cFlete = venta; _tarifaTipo = 'flete'; kmTar = km; kmVal = cKm; autoVal = cAuto; valid = true;
      }

      if (!valid) { alert('La tarifa seleccionada no cuenta con costos configurados'); return; }

      document.getElementById('f_Id_Tarifa').value = row.ID_TARIFA;
      document.getElementById('f_DesFlete').value  = (row.DESFLETE||'').trim();
      document.getElementById('f_CostoFlete').value     = cFlete.toFixed(2);
      document.getElementById('f_CostoDemoras').value   = cDem.toFixed(2);
      document.getElementById('f_KilometrosTar').value  = kmTar;
      document.getElementById('f_Kilometros').value     = kmVal.toFixed(2);
      document.getElementById('f_CostoAutopistas').value= autoVal.toFixed(2);
      const retenK = (kmVal * 0.04).toFixed(2);
      document.getElementById('f_RetenKilo').value      = retenK;
      document.getElementById('f_c_Moneda').value       = (row.MONVENTA||'').trim();
      document.getElementById('f_TipoCambio').value     = row.TIPOCAMBIO||0;
      document.getElementById('f_FlagIVA').checked      = parseInt(row.FLAGIVA) === 1;
      document.getElementById('f_FlagRet').checked      = parseInt(row.FLAGRET) === 1;
      recalcular();
    });
}

