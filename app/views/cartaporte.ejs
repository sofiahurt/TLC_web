    TotalMercancias: v('f_TotalMercancias'), PesoBrutoTotal: v('f_PesoBrutoTotal'),
    UnidadPeso: v('f_UnidadPeso')
  };

  const btnG = document.getElementById('btnGuardar');
  if (btnG) btnG.disabled = true;
  fetch('/cartaporte/guardar', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  }).then(r => r.json()).then(d => {
    if (d.error) { errEl.textContent = d.error; errEl.classList.remove('d-none'); if (btnG) btnG.disabled = false; return; }
    modal.hide(); browse.load();
  }).catch(() => { if (btnG) btnG.disabled = false; });
}

function confirmDelete() {
  if (!window._selectedRow) return;
  if (!confirm(`¿Eliminar la carta porte "${window._selectedRow.CartaPorte}"?`)) return;
  fetch('/cartaporte/eliminar', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ Serie: window._selectedRow.Serie, CartaPorte: window._selectedRow.CartaPorte })
  }).then(r => r.json()).then(d => { if (!d.error) browse.load(); });
}

// ── RECALCULAR ────────────────────────────────────────────────────────────────
function recalcular() {
  const n   = id => parseFloat(document.getElementById(id)?.value) || 0;
  const chk = id => !!document.getElementById(id)?.checked;
  const sub = n('f_CostoFlete') + n('f_CostoManiobras') + n('f_CostoDemoras') +
              n('f_CostoAutopistas') + n('f_CostoDobOpe') + n('f_CostoDisel') +
              n('f_CostoParada') * n('f_NoParadas') + n('f_CostosOtros') +
              n('f_CargoExtraTrans') + n('f_Kilometros') - n('f_RetenKilo');
  // Base para IVA y retención según tipo de tarifa
  let base;
  if (_tarifaTipo === 'renta')    base = n('f_CostoDemoras');
  else if (_tarifaTipo === 'km')  base = n('f_Kilometros');
  else                            base = n('f_CostoFlete');
  const porIVA = n('f_PorIVAMX') || 16;
  // FlagIVA=1 → exento de IVA; FlagRet=1 → exento de retención
  const iva   = chk('f_FlagIVA') ? 0 : base * (porIVA / 100);
  const reten = chk('f_FlagRet') ? 0 : base * 0.04;
  const tot   = sub + iva - reten;
  document.getElementById('f_SubTotalMX').value = sub.toFixed(2);
  document.getElementById('f_IVAMX').value      = iva.toFixed(2);
  document.getElementById('f_RetenMX').value    = reten.toFixed(2);
  document.getElementById('f_TOTALMX').value    = tot.toFixed(2);
}

