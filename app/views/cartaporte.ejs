<%- include('partials/footer') %>
<script>
// ── ESTADO ────────────────────────────────────────────────────────────────────
let _mode = 'add';
const _usuarioNombre = '<%= usuario.nombre.trim() %><%= usuario.apellido ? " " + usuario.apellido.trim() : "" %>';
let _readOnly = false;
let _statusLocked = false;
let _currentSerie = '';
let _currentCP = '';
let _currentIdCliente = '';
let _tarifaTipo = 'flete';
let _mercMode = 'add';
let _mercEditId = null;
let _depoMode = 'add';
let _depoEditId = null;
const today = new Date().toISOString().slice(0, 10);

const modal       = new bootstrap.Modal(document.getElementById('frmModal'));
const mercModal   = new bootstrap.Modal(document.getElementById('mercModal'));
const depoModal   = new bootstrap.Modal(document.getElementById('depoModal'));
const lkModal     = new bootstrap.Modal(document.getElementById('lkModal'));
const timbraModal = new bootstrap.Modal(document.getElementById('timbraModal'));

// Con modales apilados (ej. depoModal sobre frmModal), el focus-trap de Bootstrap
// hace que ESC cierre el modal de abajo en vez del que está encima. Todos los
// modales comparten el mismo z-index (1055), así que el que se ve arriba es el
// que aparece MÁS ABAJO en el HTML (frmModal < mercModal < depoModal < lkModal
// < timbraModal). Si hay más de uno abierto, cerramos solo el último del DOM.
document.addEventListener('keydown', function(e) {
  if (e.key !== 'Escape') return;
  const shown = document.querySelectorAll('.modal.show');
  if (shown.length <= 1) return;
  const top = bootstrap.Modal.getInstance(shown[shown.length - 1]);
  if (top) {
    e.preventDefault();
    e.stopPropagation();
    top.hide();
  }
}, true);

// ── BROWSE ────────────────────────────────────────────────────────────────────
let _targetCP = null;

const browse = initBrowse({
  searchInput:  document.getElementById('searchInput'),
  searchColumn: document.getElementById('searchCol'),
  tableBody:    document.getElementById('tableBody'),
  paginationEl: document.getElementById('pagination'),
  infoEl:       document.getElementById('pageInfo'),
  fetchUrl:     '/cartaporte/data',
  defaultSort:  'CartaPorte',
  defaultDir:   'desc',
  onLoad: (tbody) => {
    if (!_targetCP) return;
    const row = tbody.querySelector(`tr[data-id="${_targetCP}"]`);
    if (!row) return;
    _targetCP = null;
    row.classList.add('selected');
    window._selectedId = row.dataset.id;
    window._selectedRow = {};
    row.querySelectorAll('td[data-field]').forEach(td => {
      window._selectedRow[td.dataset.field] = td.dataset.value ?? td.textContent.trim();
    });
    document.querySelectorAll('[data-requires-selection]').forEach(b => b.disabled = false);
    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
});

fetch('/cartaporte/scroll-target')
  .then(r => r.json())
  .then(d => {
    if (!d.found) return;
    _targetCP = d.CartaPorte;
    browse.goToPage(d.page);
  });

// Actualizar estado de botones de acción según el status del registro seleccionado
document.addEventListener('click', function(e) {
  const row = e.target.closest('tr[data-id]');
  if (!row || e.target.closest('.modal-lookup')) return;
  const status = (window._selectedRow?.Status || '').trim().toLowerCase();
  const isFact = status === 'facturado';
  const btnEd = document.getElementById('btnEditar');
  const btnEl = document.getElementById('btnEliminar');
  const btnTi = document.getElementById('btnTimbrar');
  if (btnEd) btnEd.disabled = isFact;
  if (btnEl) btnEl.disabled = isFact;
  // Timbrar: solo habilitado cuando Status = EMITIDO
  if (btnTi) btnTi.disabled = (status !== 'emitido');
});

// ── OPEN MODAL ────────────────────────────────────────────────────────────────
function openEdit() {
  if (!window._selectedRow) return;
  if ((window._selectedRow.Status || '').trim().toLowerCase() === 'facturado') {
    openVisualizar(); return;
  }
  _mode = 'edit'; _readOnly = false;
  document.getElementById('frmTitle').textContent = 'Editar Carta Porte';
  document.getElementById('btnGuardar').style.display = '';
  loadForm(window._selectedRow.CartaPorte, window._selectedRow.Serie, false);
  modal.show();
}

function openVisualizar() {
  if (!window._selectedRow) return;
  _mode = 'view'; _readOnly = true;
  document.getElementById('frmTitle').textContent = 'Visualizar Carta Porte';
  document.getElementById('btnGuardar').style.display = 'none';
  loadForm(window._selectedRow.CartaPorte, window._selectedRow.Serie, true);
  modal.show();
}

function openTimbrar() {
  if (!window._selectedRow) return;
  const { CartaPorte, Serie } = window._selectedRow;

  // Resetear modal y mostrarlo mientras se valida
  document.getElementById('timbraBody').innerHTML = '<p class="text-muted mb-0"><span class="spinner-border spinner-border-sm me-2"></span>Validando datos...</p>';
  document.getElementById('btnConfirmTimbrar').style.display = 'none';
  document.getElementById('btnConfirmTimbrar').disabled = false;
  document.getElementById('btnConfirmTimbrar').innerHTML = '<i class="bi bi-file-earmark-check me-1"></i>Confirmar timbrado';
  timbraModal.show();

  fetch(`/cfdi/validar?serie=${encodeURIComponent(Serie)}&cartaporte=${encodeURIComponent(CartaPorte)}`)
    .then(r => r.json())
    .then(d => {
      if (!d.ok) {
        document.getElementById('timbraBody').innerHTML =
          `<div class="alert alert-danger mb-0">
            <strong><i class="bi bi-exclamation-triangle me-1"></i>No se puede timbrar. Datos faltantes:</strong>
            <ul class="mt-2 mb-0 ps-3">${d.errores.map(e => `<li>${e}</li>`).join('')}</ul>
          </div>`;
      } else {
        document.getElementById('timbraBody').innerHTML =
          `<p class="mb-2">¿Confirmar timbrado de la Carta Porte <strong>${CartaPorte}</strong>?</p>
           <p class="text-muted small mb-0"><i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>Esta acción sellará digitalmente el XML. El envío al PAC está pendiente de configuración.</p>`;
        document.getElementById('btnConfirmTimbrar').style.display = '';
      }
    })
    .catch(() => {
      document.getElementById('timbraBody').innerHTML = '<div class="alert alert-danger mb-0">Error al validar datos. Intente de nuevo.</div>';
    });
}

function ejecutarTimbrado() {
  if (!window._selectedRow) return;
  const { CartaPorte, Serie } = window._selectedRow;
  const btn = document.getElementById('btnConfirmTimbrar');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Procesando...';

  fetch('/cfdi/timbrar', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ serie: Serie, cartaporte: CartaPorte })
  })
  .then(r => r.json())
  .then(d => {
    btn.style.display = 'none';
    if (d.ok) {
      document.getElementById('timbraBody').innerHTML =
        `<div class="alert alert-success mb-0">
          <i class="bi bi-check-circle-fill me-2"></i><strong>${d.mensaje}</strong>
        </div>`;
    } else {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-file-earmark-check me-1"></i>Confirmar timbrado';
      document.getElementById('timbraBody').innerHTML =
        `<div class="alert alert-danger mb-0"><i class="bi bi-x-circle me-2"></i>${d.error || 'Error desconocido'}</div>`;
    }
  })
  .catch(() => {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-file-earmark-check me-1"></i>Confirmar timbrado';
    document.getElementById('timbraBody').innerHTML = '<div class="alert alert-danger mb-0">Error de comunicación con el servidor.</div>';
  });
}

function loadForm(cp, serie, ro) {
  _currentCP = cp; _currentSerie = serie;
  fetch(`/cartaporte/get?serie=${encodeURIComponent(serie)}&cartaporte=${encodeURIComponent(cp)}`)
    .then(r => r.json())
    .then(d => {
      if (d.error) { alert(d.error); return; }
      populateForm(d);
      if (_mode === 'edit') {
        if (!document.getElementById('f_FechaPedido').value) document.getElementById('f_FechaPedido').value = today;
        if (!document.getElementById('f_Status').value)      document.getElementById('f_Status').value = 'EMITIDO';
        document.getElementById('f_RealizoPedido').value = _usuarioNombre;
      }
      _statusLocked = false;
      setReadOnly(ro);
      applyRequiredHighlight(!ro);
      _currentIdCliente = String(d.Id_Cliente || '');
      toggleSeccionCliente();
      const st = (d.Status || '').trim().toUpperCase();
      if (_mode === 'edit' && st === 'EMITIDO') lockEmitidoFields();
      if (st === 'FACTURADO' || st === 'TRASLADO') lockStatusFields();
      loadMercancias(serie, cp);
      loadDepositos(serie, cp);
    });
}

const _REQUIRED_FIELDS = [
  'f_FehcaCarga','f_FechaDesCarta',
  'f_NombreComunCli','f_DesFlete','f_NoCamion',
  'f_NoCaja','f_Operador','f_DomCarga','f_DomDescarga'
];
function applyRequiredHighlight(show) {
  _REQUIRED_FIELDS.forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.style.backgroundColor = show ? '#FFF8DC' : '';
    el.style.borderColor     = show ? '#E8A020' : '';
  });
}

function populateForm(d) {
  const set = (id, val) => { const el = document.getElementById(id); if (el) el.value = val ?? ''; };
  const chk = (id, val) => { const el = document.getElementById(id); if (el) el.checked = !!parseInt(val); };
  set('f_Serie', d.Serie); set('f_CartaPorte', d.CartaPorte);
  set('f_FechaPedido', d.FechaPedido); set('f_FehcaCarga', d.FehcaCarga);
  set('f_HoraCarga', d.HoraCarga); set('f_FechaDesCarta', d.FechaDesCarta);
  set('f_HorarioDesCarta', d.HorarioDesCarta);
  document.getElementById('f_Id_Cliente').value = d.Id_Cliente;
  set('f_NombreComunCli', d.NombreComunCli);
  document.getElementById('f_Id_ClienteEnt').value = d.Id_ClienteEnt;
  set('f_ClienteEnt', d.ClienteEnt);
  document.getElementById('f_Id_ClienteCarga').value = d.Id_ClienteCarga;
  set('f_ClienteCarga', d.ClienteCarga);
  set('f_Booking', d.Booking); set('f_NoRainde', d.NoRainde);
  set('f_Contenedor', d.Contenedor);
  document.getElementById('f_Id_Tarifa').value = d.Id_Tarifa;
  set('f_DesFlete', d.DesFlete);
  document.getElementById('f_Id_Camion').value = d.Id_Camion;
  set('f_NoCamion', d.NoCamion); set('f_NoPlacas', d.NoPlacas);
  set('f_NoCaja', d.NoCaja); set('f_NoCaja2', d.NoCaja2);
  document.getElementById('f_Id_Operador').value = d.Id_Operador;
  set('f_Operador', d.Operador);
  document.getElementById('f_Id_DomCarga').value = d.Id_DomCarga;
  set('f_DomCarga', d.DomCarga);
  document.getElementById('f_Id_DomDescarga1').value = d.Id_DomDescarga1;
  set('f_DomDescarga', d.DomDescarga);
  set('f_Status', d.Status); set('f_RealizoPedido', d.RealizoPedido);
  set('f_Observaciones', d.Observaciones);
  // costos
  ['CostoFlete','CostoManiobras','CostoDemoras','CostoAutopistas','CostoDobOpe','CostoDisel',
   'NoParadas','CostoParada','CostosOtros','CargoExtraTrans','Kilometros','KilometrosTar',
   'RetenKilo','c_Moneda','TipoCambio','DesOtrosCostos',
   'PorIVAMX','SubTotalMX','IVAMX','RetenMX','TOTALMX',
   'CostoPrestamo','CostoTalacha','CostoCompllanta','CostoDiesel','CostoCasetas',
   'CostoComidas','CostoManiobrasExt','CostoBascula','CostoPension','CostoRefacciones','CostoOtros'
  ].forEach(k => set('f_' + k, d[k]));
  ['FlagCobMan','FlagCobDem','FlagCobAuto','FlagCobDO','FlagConDis','FlagCobParada',
   'FlagCobOtros','FlagCobCE','FlagIVA','FlagRet'
  ].forEach(k => chk('f_' + k, d[k]));
  set('f_UnidadPeso', d.UnidadPeso || 'KGM');
  // Inferir tipo de tarifa para recalcular correctamente
  const dem = parseFloat(d.CostoDemoras) || 0;
  const fl  = parseFloat(d.CostoFlete)   || 0;
  const km  = parseFloat(d.Kilometros)   || 0;
  if (dem > 0 && fl === 0 && km === 0)       _tarifaTipo = 'renta';
  else if (km > 0 && fl === 0 && dem === 0)  _tarifaTipo = 'km';
  else                                        _tarifaTipo = 'flete';
}

function clearForm() {
  document.querySelectorAll('#frmModal input:not([readonly]), #frmModal textarea, #frmModal select').forEach(el => {
    if (el.type === 'checkbox') el.checked = false;
    else el.value = '';
  });
  document.getElementById('f_PorIVAMX').value = 16;
  document.getElementById('f_UnidadPeso').value = 'KGM';
  _currentIdCliente = '';
  _currentCP = '';
  _currentSerie = '';
  _tarifaTipo = 'flete';
  toggleSeccionCliente();
}

function setReadOnly(ro) {
  document.querySelectorAll('#frmModal input, #frmModal textarea, #frmModal select').forEach(el => {
    if (el.type !== 'hidden') { el.disabled = ro; el.readOnly = ro && el.tagName !== 'SELECT'; }
  });
  document.querySelectorAll('#frmModal button:not([data-bs-dismiss])').forEach(b => b.disabled = ro);
  // Serie y CartaPorte siempre readonly
  ['f_Serie','f_CartaPorte','f_FechaPedido','f_RealizoPedido',
   'f_TotalMercancias','f_PesoBrutoTotal'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.readOnly = true; el.disabled = false; }
  });
  // Status no editable en modo edición (solo en alta)
  if (_mode === 'edit') {
    const elSt = document.getElementById('f_Status');
    if (elSt) { elSt.readOnly = true; elSt.disabled = false; }
  }
  // Tab Costos siempre de solo lectura
  document.querySelectorAll('#tabCostos input').forEach(el => {
    if (el.type !== 'hidden' && el.type !== 'checkbox') { el.readOnly = true; el.disabled = false; }
  });
}

function toggleSeccionCliente() {
  document.getElementById('seccionDependienteCliente').style.display = _currentIdCliente ? '' : 'none';
}

function lockEmitidoFields() {
  ['f_FehcaCarga','f_HoraCarga','f_FechaDesCarta','f_HorarioDesCarta',
   'f_NombreComunCli','f_ClienteEnt','f_ClienteCarga','f_DesFlete'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.readOnly = true; el.style.backgroundColor = '#f0f0f0'; }
  });
  ['btnLkCliente','btnClearCliente','btnLkClienteEnt','btnLkClienteCarga',
   'btnLkTarifa','btnLkDomCarga','btnLkDomDescarga'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.disabled = true;
  });
}

function lockStatusFields() {
  _statusLocked = true;
  // Bloquear toda la tab Carta Porte
  document.querySelectorAll('#tabCP input, #tabCP select, #tabCP textarea, #tabCP button').forEach(el => {
    if (el.type !== 'hidden') el.disabled = true;
  });
  // Ocultar botón Agregar en Mercancías
  const mercBtn = document.querySelector('#tabMerc > div > button');
  if (mercBtn) mercBtn.style.display = 'none';
  // Ocultar botón Guardar principal
  const btnG = document.getElementById('btnGuardar');
