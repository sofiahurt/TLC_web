// ── Lookup Factura / ND (2 pestañas) ───────────────────────────────────
let docLkPage=1, docLkTipo='factura'; const docLkModal=new bootstrap.Modal(document.getElementById('lookupDoc'));
function openLookupDocumento(){
  const idCliente=document.getElementById('f_Id_Cliente').value;
  if(!idCliente){showError('Seleccione primero el cliente facturado.');return;}
  hideError();
  docLkPage=1; docLkTipo='factura';
  document.querySelectorAll('#docLkTabs .nav-link').forEach(a=>a.classList.toggle('active', a.dataset.doc===docLkTipo));
  document.getElementById('docLkQ').value='';
  loadDocLk();
  docLkModal.show();
}
function docLkSwitchTab(a){
  docLkTipo=a.dataset.doc; docLkPage=1;
  document.querySelectorAll('#docLkTabs .nav-link').forEach(x=>x.classList.toggle('active', x===a));
  loadDocLk();
  return false;
}
function loadDocLk(){
  const idCliente=document.getElementById('f_Id_Cliente').value;
  const q=document.getElementById('docLkQ').value;
  const url = docLkTipo==='factura' ? '/pagos/lookup/facturas' : '/pagos/lookup/notasdebito';
  let excl='';
  if(_pago.idNoPago) excl=`&excluirId=${_pago.idNoPago}`;
  fetch(`${url}?idCliente=${idCliente}&q=${encodeURIComponent(q)}&page=${docLkPage}${excl}`).then(r=>r.json()).then(d=>{
    document.getElementById('docLkBody').innerHTML=d.rows.map(r=>{
      const folio = docLkTipo==='factura' ? r.Id_NoFactura : r.Id_NotaDebito;
      const fecha = docLkTipo==='factura' ? r.FechaFactura : r.Fecha;
      const total = docLkTipo==='factura' ? r.TOTAL : r.ImporteTotal;
      // ND es todo-o-nada: si aparece en la lista es porque aún no se ha
      // pagado nada, así que "Pagos realizados" siempre es 0 y Saldo=Total.
      const pagosRealizados = docLkTipo==='factura' ? r.PagosRealizados : 0;
      const saldo = docLkTipo==='factura' ? r.Saldo : r.ImporteTotal;
      const serieRef = docLkTipo==='factura' ? (r.SerieFac||'') : (r.SerieND||'');
      return `<tr data-folio="${folio}" data-serie="${serieRef}" style="cursor:pointer"><td>${folio}</td><td>${fecha}</td><td class="text-end">${fmtMoney(total)}</td><td class="text-end">${fmtMoney(pagosRealizados)}</td><td class="text-end">${fmtMoney(saldo)}</td><td>${r.Status||''}</td></tr>`;
    }).join('');
    document.getElementById('docLkInfo').textContent=`Pág ${d.page}/${d.totalPages} — ${d.total} registros`;
    document.getElementById('docLkPrev').disabled=d.page<=1;
    document.getElementById('docLkNext').disabled=d.page>=d.totalPages;
  });
}
document.getElementById('docLkQ').addEventListener('input',debounce(()=>{docLkPage=1;loadDocLk();},300));
document.getElementById('docLkPrev').addEventListener('click',()=>{if(docLkPage>1){docLkPage--;loadDocLk();}});
document.getElementById('docLkNext').addEventListener('click',()=>{docLkPage++;loadDocLk();});
document.getElementById('docLkBody').addEventListener('click',e=>{
  const row=e.target.closest('tr[data-folio]'); if(!row) return;
  docLkModal.hide();
  agregarLinea(docLkTipo, row.dataset.folio, row.dataset.serie);
});

// ── Ubicar un renglón YA agregado a este Cobro (filtra la tabla de líneas,
// no busca nuevos documentos -- eso lo hace "Buscar Factura o Nota de
// Débito..."). Útil cuando hay muchas líneas (ej. un Cobro con 15+ facturas).
document.getElementById('filtroLineasQ').addEventListener('input', aplicarFiltroLineas);
function aplicarFiltroLineas(){
  const q=document.getElementById('filtroLineasQ').value.trim().toLowerCase();
  const rows=document.querySelectorAll('#detBody tr[data-idd]');
  let visibles=0;
  rows.forEach(row=>{
    const texto=(row.dataset.folio||'').toLowerCase();
    const match=!q||texto.includes(q);
    row.style.display=match?'':'none';
    if(match) visibles++;
  });
  const total=_lineasActuales.length;
  document.getElementById('detCount').textContent = q
    ? `${visibles} de ${total} ${total===1?'documento':'documentos'} (filtrado)`
    : `${total} ${total===1?'documento':'documentos'}`;
}

function agregarLinea(tipoDoc, folio, serieRef){
  hideError();
  const idCliente=document.getElementById('f_Id_Cliente').value;
  const body={
    idNoPago:_pago.idNoPago||'', idCliente,
    idRealPago:document.getElementById('f_Id_RealPago').value||idCliente,
    fecha:document.getElementById('f_Fecha').value,
    fechaPago:document.getElementById('f_FechaPago').value,
    c_FormaPago:document.getElementById('f_c_FormaPago').value.trim(),
    FormaPago:document.getElementById('f_c_FormaPago_disp').value.trim(),
    moneda:document.getElementById('f_Moneda').value.trim(),
    tipoCambio:document.getElementById('f_TipoCambio').value,
    flagCompensacion:document.getElementById('f_FlagCompensacion').checked?1:0,
    bancoDeposito:document.getElementById('f_BancoDeposito').value.trim(),
    tipoDeposito:document.getElementById('f_TipoDeposito').value.trim(),
    noCheque:document.getElementById('f_NoCheque').value.trim(),
    bancoEmisor:document.getElementById('f_BancoEmisor').value.trim(),
  };
  if(tipoDoc==='factura'){ body.idNoFactura=folio; body.serieFacRef=serieRef; }
  else { body.idNotaDebito=folio; body.serieND=serieRef; }
  fetch('/pagos/partida/agregar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
    .then(r=>r.json()).then(d=>{
      if(d.error){showError(d.error);return;}
      _pago.idNoPago=d.idNoPago;
      document.getElementById('f_Id_NoPago').value=d.idNoPago;
      document.getElementById('f_NombreCom_disp').readOnly=true;
      // Al agregar, entra directo a editar el importe a pagar de la línea
      // recién insertada (ND no aplica: es todo-o-nada, sin botón de editar).
      cargarPago(d.idNoPago, ()=>{
        const row=document.querySelector(`tr[data-idd="${d.idNoPagFac}"]`);
        const editBtn=row&&row.querySelector('.btn-editar-importe');
        if(editBtn) activarEdicionLinea(editBtn, d.idNoPagFac);
      });
    });
}

function grabarPago(){
  if(!_pago.idNoPago){showError('Agregue al menos una línea antes de grabar.');return;}
  fetch('/pagos/cabecera/grabar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
    idNoPago:_pago.idNoPago,
  })}).then(r=>r.json()).then(d=>{
    if(d.error){showError(d.error);return;}
    _pago.confirmada=true;
    modal.hide();
    browse.load();
  });
}

function onCerrarModal(){
  if(_pago.idNoPago && !_pago.confirmada){
    fetch('/pagos/cabecera/cancelar-sin-confirmar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
      idNoPago:_pago.idNoPago,
    })}).then(()=>browse.load());
  }
  return true;
}

function confirmCancelarPago(){
  if(!window._selectedRow) return;
  const yaTimbrado=!!(window._selectedRow.UUID||'').trim();
  if(yaTimbrado){
    document.getElementById('cancelarPagoError').classList.add('d-none');
    onCambiaMotivoPago();
    new bootstrap.Modal(document.getElementById('cancelarPagoModal')).show();
    return;
  }
  if(!confirm('¿Cancelar este cobro? Esta acción revierte su efecto sobre el saldo de las facturas relacionadas.')) return;
  fetch('/pagos/cancelar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
    idNoPago:window._selectedRow.Id_NoPago,
  })}).then(r=>r.json()).then(d=>{ if(d.error){alert(d.error);return;} browse.load(); });
}
function onCambiaMotivoPago(){
  document.getElementById('rowFolioSustitucionPago').classList.toggle('d-none', document.getElementById('cancMotivoPago').value!=='01');
}
function ejecutarCancelacionFiscalPago(){
  const motivo=document.getElementById('cancMotivoPago').value;
  const folioSustitucion=motivo==='01'?document.getElementById('cancFolioSustitucionPago').value.trim():'';
  if(motivo==='01' && !folioSustitucion){
    const e=document.getElementById('cancelarPagoError'); e.textContent='Debe indicar el UUID que sustituye.'; e.classList.remove('d-none'); return;
  }
  const btn=document.getElementById('btnConfirmCancelarPago');
  btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Procesando...';
  fetch('/cfdi/cancelar-pago',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
    idNoPago:window._selectedRow.Id_NoPago, motivo, folioSustitucion,
  })}).then(r=>r.json()).then(d=>{
    btn.disabled=false; btn.innerHTML='<i class="bi bi-x-circle me-1"></i>Confirmar cancelación';
    if(d.error || !d.ok){
      const e=document.getElementById('cancelarPagoError'); e.textContent=d.error||'El PAC rechazó la cancelación.'; e.classList.remove('d-none'); return;
    }
    bootstrap.Modal.getInstance(document.getElementById('cancelarPagoModal')).hide();
    browse.load();
  });
}

