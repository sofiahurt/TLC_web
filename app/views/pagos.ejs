function pintarTotales(lineas){
  const pagado=lineas.reduce((a,l)=>a+(parseFloat(l.IMPRTE)||0),0);
  const comp=lineas.reduce((a,l)=>a+(parseFloat(l.COMPESACION)||0),0);
  const total=lineas.reduce((a,l)=>a+(parseFloat(l.TOTALPAGO)||0),0);
  document.getElementById('totPagado').textContent=fmtMoney(pagado);
  document.getElementById('totComp').textContent=fmtMoney(comp);
  document.getElementById('totGran').textContent=fmtMoney(total);
}

function filaDetalleHtml(l){
  const ref = Number(l.NOFACTURA)>0 ? ('Factura #'+l.NOFACTURA) : ('ND #'+l.ID_NOTACREDITO);
  const puedeEditar = Number(l.NOFACTURA)>0; // ND es todo o nada, sin edición
  // Pagos realizados ANTES de esta línea (sin incluir este mismo cobro) =
  // total original del documento menos el saldo que ya traía al momento de
  // agregarse (SALDOANT). SALDOANT solo es confiable si es >= lo que esta
  // misma línea aplicó (TOTALPAGO); si no (filas legado importadas del
  // sistema anterior con SALDOANT=0), se asume que este cobro por sí solo
  // liquidó el total, igual que en la generación del XML (ver cfdi-pago.js)
  // -- si no, "pagos realizados" terminaba mostrando el total completo,
  // como si el propio cobro actual ya contara como pago anterior.
  const totalDoc = parseFloat(l.TOTALDOC)||0;
  const totalPagoLinea = parseFloat(l.TOTALPAGO)||0;
  const saldoAntesDeEstePago = (parseFloat(l.SALDOANT)||0) >= totalPagoLinea - 0.005 ? (parseFloat(l.SALDOANT)||0) : totalPagoLinea;
  const pagosRealizados = Math.max(0, totalDoc - saldoAntesDeEstePago);
  const celdaImprte = puedeEditar
    ? `<td class="text-end"><span class="imprte-disp">${fmtMoney(l.IMPRTE)}</span><input type="text" inputmode="decimal" class="form-control form-control-sm text-end py-0 imprte-edit d-none" style="width:95px;display:inline-block" value="${fmtMoney(l.IMPRTE)}"></td>`
    : `<td class="text-end">${fmtMoney(l.IMPRTE)}</td>`;
  const celdaComp = _pago.flagCompensacion
    ? (puedeEditar
        ? `<td class="text-end"><span class="comp-disp">${fmtMoney(l.COMPESACION)}</span><input type="text" inputmode="decimal" class="form-control form-control-sm text-end py-0 comp-edit d-none" style="width:95px;display:inline-block" value="${fmtMoney(l.COMPESACION)}"></td>`
        : `<td class="text-end">${fmtMoney(l.COMPESACION)}</td>`)
    : '';
  const btnEditar = puedeEditar
    ? `<button class="btn btn-sm btn-outline-secondary py-0 px-1 btn-editar-importe" title="Editar" onclick="activarEdicionLinea(this, ${l.ID_NOPAGFAC})"><i class="bi bi-pencil"></i></button>`
    : '';
  const folioBusqueda = Number(l.NOFACTURA)>0 ? l.NOFACTURA : l.ID_NOTACREDITO;
  return `<tr data-idd="${l.ID_NOPAGFAC}" data-saldo="${saldoAntesDeEstePago}" data-folio="${folioBusqueda}">
    <td>${ref}</td>
    <td class="text-end">${fmtMoney(pagosRealizados)}</td>
    <td class="text-end">${fmtMoney(saldoAntesDeEstePago)}</td>
    ${celdaImprte}
    ${celdaComp}
    <td class="text-end">${fmtMoney(l.TOTALPAGO)}</td>
    <td class="text-center">${btnEditar} <button class="btn btn-sm btn-outline-danger py-0 px-1" onclick="eliminarLinea(${l.ID_NOPAGFAC})"><i class="bi bi-trash"></i></button></td>
  </tr>`;
}
let _lineasActuales=[];
function pintarDetalle(lineas){
  onFlagCompensacionUI();
  _lineasActuales=lineas;
  document.getElementById('detBody').innerHTML=lineas.map(filaDetalleHtml).join('');
  aplicarFiltroLineas();
  pintarTotales(lineas);
}

document.getElementById('detBody').addEventListener('dblclick', function(e){
  const row=e.target.closest('tr[data-idd]');
  if(!row) return;
  const editBtn=row.querySelector('.btn-editar-importe');
  if(editBtn) activarEdicionLinea(editBtn, Number(row.dataset.idd));
});
function activarEdicionLinea(btn, idDeta){
  const row=btn.closest('tr');
  row.querySelectorAll('.imprte-disp,.comp-disp').forEach(el=>el.classList.add('d-none'));
  row.querySelectorAll('.imprte-edit,.comp-edit').forEach(el=>el.classList.remove('d-none'));
  btn.outerHTML = `<button class="btn btn-sm btn-outline-success py-0 px-1" title="Confirmar" onclick="confirmarEdicionLinea(this, ${idDeta})"><i class="bi bi-check-lg"></i></button>`;
  const imprteInp=row.querySelector('.imprte-edit');
  const compInp=row.querySelector('.comp-edit');
  // Máscara de dinero ($1,234.56): en foco se muestra el número plano para
  // editar cómodo, al perder el foco se vuelve a formatear.
  [imprteInp, compInp].forEach(inp=>{
    if(!inp) return;
    inp.addEventListener('focus', function(){ const v=parseMoneyInput(inp.value); inp.value=v?fmtN(v):''; });
    inp.addEventListener('blur', function(){ inp.value=fmtMoney(parseMoneyInput(inp.value)); });
  });
  // Con compensación activa, capturar uno de los dos importes calcula el
  // otro automáticamente para que sumen siempre el saldo disponible antes de
  // este cobro (data-saldo, ya calculado al pintar la fila).
  if(imprteInp && compInp){
    const saldoDisp=parseFloat(row.dataset.saldo)||0;
    imprteInp.addEventListener('input', function(){
      compInp.value=Math.max(0, saldoDisp-parseMoneyInput(imprteInp.value)).toFixed(2);
    });
    compInp.addEventListener('input', function(){
      imprteInp.value=Math.max(0, saldoDisp-parseMoneyInput(compInp.value)).toFixed(2);
    });
  }
  // ESC cancela solo la edición de esta línea (no debe cerrar el modal del
  // Cobro completo -- mismo tipo de bug ya corregido para modales anidados).
  // Enter guarda (dispara el mismo botón "Confirmar").
  function onKeyLinea(e){
    if(e.key==='Escape'){ e.preventDefault(); e.stopPropagation(); cancelarEdicionLinea(row, idDeta); }
    else if(e.key==='Enter'){ e.preventDefault(); e.stopPropagation(); confirmarEdicionLinea(row.querySelector('.btn-outline-success'), idDeta); }
  }
  [imprteInp, compInp].forEach(inp=>inp && inp.addEventListener('keydown', onKeyLinea));
  const first=imprteInp; if(first){first.focus(); first.select();}
}
function cancelarEdicionLinea(row, idDeta){
  row.querySelectorAll('.imprte-edit,.comp-edit').forEach(el=>el.classList.add('d-none'));
  row.querySelectorAll('.imprte-disp,.comp-disp').forEach(el=>el.classList.remove('d-none'));
  const checkBtn=row.querySelector('.btn-outline-success');
  if(checkBtn) checkBtn.outerHTML = `<button class="btn btn-sm btn-outline-secondary py-0 px-1 btn-editar-importe" title="Editar" onclick="activarEdicionLinea(this, ${idDeta})"><i class="bi bi-pencil"></i></button>`;
}
function confirmarEdicionLinea(btn, idDeta){
  const row=btn.closest('tr');
  const imprte=parseMoneyInput(row.querySelector('.imprte-edit')?.value);
  const compEl=row.querySelector('.comp-edit');
  const compensacion=compEl?parseMoneyInput(compEl.value):0;
  ajustarImporteLinea(idDeta, imprte, compensacion);
}
function ajustarImporteLinea(idNoPagFac, imprte, compensacion){
  if(!_pago.idNoPago) return;
  hideError();
  fetch('/pagos/linea/actualizar-importe',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
    idNoPago:_pago.idNoPago, idNoPagFac, imprte, compensacion,
  })}).then(r=>r.json()).then(d=>{
    if(d.error){showError(d.error);return;}
    hideWarning();
    if(d.limitado) showWarning('El importe se limitó al saldo disponible: '+fmtMoney(d.saldoDisponible));
    cargarPago(_pago.idNoPago);
  });
}

function eliminarLinea(idNoPagFac){
  if(!_pago.idNoPago) return;
  fetch('/pagos/partida/eliminar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
    idNoPago:_pago.idNoPago, idNoPagFac,
  })}).then(r=>r.json()).then(d=>{
    if(d.error){showError(d.error);return;}
    cargarPago(_pago.idNoPago);
  });
}

