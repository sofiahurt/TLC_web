document.addEventListener('click', function(e){
  const row=e.target.closest('tr[data-id]');
  if(!row || e.target.closest('.modal-lookup')) return;
  const btnTi=document.getElementById('btnTimbrarPago');
  const btnCa=document.getElementById('btnCancelarPago');
  const yaTimbrado=!!(window._selectedRow?.UUID||'').trim();
  const status=(window._selectedRow?.Status||'').trim().toUpperCase();
  if(btnTi) btnTi.disabled = yaTimbrado || status==='CANCELADO';
  if(btnCa) btnCa.disabled = status==='CANCELADO';
