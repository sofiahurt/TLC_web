<%- include('partials/header', { titulo: 'Cobros' }) %>
<%- include('partials/sidebar') %>
<div id="page-content">
  <div class="d-flex align-items-center mb-3">
    <button class="btn btn-sm btn-outline-secondary me-3 d-md-none" id="sidebarToggle"><i class="bi bi-list fs-5"></i></button>
    <h4 class="mb-0 fw-bold flex-grow-1">Cobros</h4>
  </div>

  <div class="card border-0 shadow-sm mb-3 barra-filtros"><div class="card-body py-2">
    <div class="row align-items-center g-2">
      <div class="col-auto"><select id="searchCol" class="form-select form-select-sm">
        <option value="Id_NoPago">No.</option><option value="NombreCom">Cliente</option><option value="NomClientePago">Paga</option><option value="Status">Status</option>
      </select></div>
      <div class="col col-md-4"><input type="text" id="searchInput" class="form-control form-select-sm" placeholder="Buscar..."></div>
      <div class="col-auto ms-auto btn-action-group">
        <button class="btn btn-sm btn-success" onclick="openAdd()"><i class="bi bi-plus-lg"></i> Nuevo Cobro</button>
        <button class="btn btn-sm btn-primary" data-requires-selection disabled onclick="openEdit()"><i class="bi bi-eye"></i> Ver / Editar</button>
        <% if (tienePermiso('pagos.btn_timbrar')) { %>
        <button class="btn btn-sm btn-warning" id="btnTimbrarPago" disabled onclick="openTimbrarPago()"><i class="bi bi-file-earmark-check"></i> Timbrar</button>
        <% } %>
        <% if (tienePermiso('pagos.btn_cancelar')) { %>
        <button class="btn btn-sm btn-danger" id="btnCancelarPago" data-requires-selection disabled onclick="confirmCancelarPago()"><i class="bi bi-x-circle"></i> Cancelar</button>
        <% } %>
      </div>
    </div>
  </div></div>

  <div class="card border-0 shadow-sm"><div class="card-body p-0">
    <div class="table-responsive"><table class="table table-hover table-sm mb-0">
      <thead class="thead-tlc"><tr>
        <th data-sort="Id_NoPago" style="width:70px">No. <span class="sort-icon"></span></th>
        <th data-sort="Fecha" style="width:100px">Fecha <span class="sort-icon"></span></th>
        <th data-sort="FechaPago" style="width:100px">Fecha Cobro <span class="sort-icon"></span></th>
        <th data-sort="NombreCom">Cliente <span class="sort-icon"></span></th>
        <th data-sort="NomClientePago">Paga <span class="sort-icon"></span></th>
        <th class="text-end" style="width:120px">Total</th>
        <th data-sort="Status" style="width:100px">Status <span class="sort-icon"></span></th>
        <th style="width:50px">XML</th>
        <th style="width:50px">PDF</th>
        <th style="width:50px">Acuse</th>
      </tr></thead>
      <tbody id="tableBody"></tbody>
    </table></div>
  </div>
  <div class="card-footer bg-white d-flex align-items-center justify-content-between py-2">
    <span class="page-info" id="pageInfo"></span>
    <div id="pagination">
      <button class="btn btn-sm btn-outline-secondary" data-action="prev"><i class="bi bi-chevron-left"></i> Anterior</button>
      <button class="btn btn-sm btn-outline-secondary" data-action="next">Siguiente <i class="bi bi-chevron-right"></i></button>
    </div>
  </div></div>
</div>

<!-- ═══════════════ MODAL PAGO ═══════════════ -->
<div class="modal fade" id="frmModal" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="frmTitle">Nuevo Cobro</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="return onCerrarModal()"></button>
      </div>
      <div class="modal-body">
        <div id="frmError" class="alert alert-danger d-none py-2 small"></div>
        <div id="frmWarning" class="alert alert-warning d-none py-2 small"></div>

        <div class="row g-2 mb-2">
          <div class="col-md-9">
            <div class="row g-2 align-items-end">
              <div class="col-md-2"><label class="form-label fw-semibold small mb-1">No.</label>
                <input type="text" id="f_Id_NoPago" class="form-control form-control-sm bg-light" readonly></div>
              <div class="col-md-5">
                <label class="form-label fw-semibold small mb-1">Cliente facturado <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm">
                  <input type="hidden" id="f_Id_Cliente">
                  <input type="text" id="f_NombreCom_disp" class="form-control form-control-sm" placeholder="Seleccionar cliente..." readonly>
                  <button class="btn btn-outline-secondary btn-sm" type="button" onclick="openLookupCliente('facturado')"><i class="bi bi-search"></i></button>
                </div>
              </div>
              <div class="col-md-3"><label class="form-label fw-semibold small mb-1">RFC</label>
                <input type="text" id="f_RFC" class="form-control form-control-sm bg-light" readonly></div>
              <div class="col-md-2"><label class="form-label small mb-1">Status</label>
                <input type="text" id="f_Status" class="form-control form-control-sm bg-light" readonly></div>
            </div>
            <div class="row g-2 mt-1 align-items-end">
              <div class="col-md-7">
                <label class="form-label small mb-1">Cliente que paga (si es distinto)</label>
                <div class="input-group input-group-sm">
                  <input type="hidden" id="f_Id_RealPago">
                  <input type="text" id="f_NomClientePago_disp" class="form-control form-control-sm" placeholder="Igual al facturado..." readonly>
                  <button class="btn btn-outline-secondary btn-sm" type="button" onclick="openLookupCliente('paga')"><i class="bi bi-search"></i></button>
                </div>
              </div>
              <div class="col-md-2 pb-1">
                <div class="form-check"><input type="checkbox" id="f_FlagCompensacion" class="form-check-input" onchange="onCabeceraFieldChange()"><label class="form-check-label small" for="f_FlagCompensacion">Con Compensación</label></div>
              </div>
            </div>
            <div class="row g-2 mt-1">
              <div class="col-md-3">
                <label class="form-label small mb-1">Banco depósito</label>
                <input type="text" id="f_BancoDeposito" class="form-control form-control-sm" maxlength="60" onchange="onCabeceraFieldChange()">
              </div>
              <div class="col-md-3">
                <label class="form-label small mb-1">Tipo depósito</label>
                <input type="text" id="f_TipoDeposito" class="form-control form-control-sm" maxlength="20" onchange="onCabeceraFieldChange()">
              </div>
              <div class="col-md-3">
                <label class="form-label small mb-1">No. Cheque/Referencia</label>
                <input type="text" id="f_NoCheque" class="form-control form-control-sm" maxlength="20" onchange="onCabeceraFieldChange()">
              </div>
              <div class="col-md-3">
                <label class="form-label small mb-1">Banco emisor</label>
                <input type="text" id="f_BancoEmisor" class="form-control form-control-sm" maxlength="60" onchange="onCabeceraFieldChange()">
              </div>
            </div>
            <div class="row g-2 mt-1">
              <div class="col-md-6 d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-primary" id="btnBuscarDoc" onclick="openLookupDocumento()"><i class="bi bi-search"></i> Buscar Factura o Nota de Débito...</button>
                <input type="text" id="filtroLineasQ" class="form-control form-control-sm" style="width:160px" placeholder="Ubicar folio agregado...">
              </div>
            </div>
          </div>

          <div class="col-md-3">
            <label class="form-label small mb-1">Fecha de creación</label>
            <div class="input-group input-group-sm mb-2">
              <input type="date" id="f_Fecha" class="form-control form-control-sm" onchange="onCabeceraFieldChange()">
            </div>
            <label class="form-label fw-semibold small mb-1">Fecha del cobro</label>
            <div class="input-group input-group-sm mb-2">
              <input type="date" id="f_FechaPago" class="form-control form-control-sm" onchange="onCabeceraFieldChange()">
            </div>
            <label class="form-label small mb-1">Forma de pago</label>
            <div class="input-group input-group-sm mb-2">
              <input type="hidden" id="f_c_FormaPago">
              <input type="text" id="f_c_FormaPago_disp" class="form-control form-control-sm bg-light" placeholder="Seleccionar..." readonly>
              <button class="btn btn-outline-secondary btn-sm sat-lupa-btn" type="button" onclick="openLookupSat('formaPago')"><i class="bi bi-search"></i></button>
            </div>
            <label class="form-label small mb-1">Moneda</label>
            <div class="input-group input-group-sm mb-2">
              <input type="hidden" id="f_Moneda">
              <input type="text" id="f_Moneda_disp" class="form-control form-control-sm bg-light" placeholder="Seleccionar..." readonly>
              <button class="btn btn-outline-secondary btn-sm sat-lupa-btn" type="button" onclick="openLookupSat('moneda')"><i class="bi bi-search"></i></button>
            </div>
            <div id="rowTipoCambio" style="display:none">
              <label class="form-label small mb-1">Tipo de cambio</label>
              <input type="number" id="f_TipoCambio" class="form-control form-control-sm mb-2" step="0.0001" min="0" onchange="onCabeceraFieldChange()">
            </div>
          </div>
        </div>

        <!-- Detalle -->
        <div class="table-responsive">
          <table class="table table-sm table-bordered align-middle" id="tblDetalle" style="font-size:.78rem">
            <thead class="table-light">
              <tr>
                <th>Referencia</th>
                <th class="text-end">Pagos realizados</th>
                <th class="text-end">Saldo disp.</th>
                <th class="text-end">Pagado</th>
                <th class="text-end" id="thComp" style="display:none">Compensado</th>
                <th class="text-end">Total</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="detBody"></tbody>
            <tfoot>
              <tr class="fw-bold table-light">
                <td colspan="3" class="text-end">Totales:</td>
                <td class="text-end" id="totPagado">0.00</td>
                <td class="text-end" id="totComp" style="display:none">0.00</td>
                <td class="text-end" id="totGran">0.00</td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <div class="small text-muted mb-2" id="detCount">0 documentos</div>

        <div class="row g-2 mt-2">
          <div class="col-md-12 small text-muted">Realizó: <strong id="f_Realizo_disp"><%= usuario.nombre.trim() %> <%= usuario.apellido ? usuario.apellido.trim() : '' %></strong></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal" onclick="return onCerrarModal()"><i class="bi bi-x-lg"></i> Cerrar</button>
        <button class="btn btn-primary" onclick="grabarPago()"><i class="bi bi-check2"></i> Grabar</button>
      </div>
    </div>
  </div>
</div>

<!-- Lookup Cliente (compartido: facturado / paga, según _lkCliTarget) -->
<div class="modal fade modal-lookup" id="lookupCliente" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg">
  <div class="modal-content">
    <div class="modal-header py-2"><h6 class="modal-title" id="lkCliTitle">Seleccionar Cliente</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <input type="text" id="lkCliQ" class="form-control form-control-sm mb-2" placeholder="Buscar cliente...">
      <table class="table table-hover table-sm"><thead class="table-secondary"><tr><th>ID</th><th>Nombre</th><th>RFC</th></tr></thead>
      <tbody id="lkCliBody"></tbody></table>
      <div class="d-flex justify-content-between align-items-center">
        <span id="lkCliInfo" class="small text-muted"></span>
        <div><button class="btn btn-sm btn-outline-secondary" id="lkCliPrev">‹</button> <button class="btn btn-sm btn-outline-secondary" id="lkCliNext">›</button></div>
      </div>
    </div>
  </div>
</div></div>

<!-- Lookup Factura / Nota de Débito (2 pestañas) -->
<div class="modal fade modal-lookup" id="lookupDoc" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg">
  <div class="modal-content">
    <div class="modal-header py-2"><h6 class="modal-title">Seleccionar Factura o Nota de Débito</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <ul class="nav nav-tabs mb-2" id="docLkTabs">
        <li class="nav-item"><a class="nav-link active" data-doc="factura" href="#" onclick="return docLkSwitchTab(this)">Facturas</a></li>
        <li class="nav-item"><a class="nav-link" data-doc="nd" href="#" onclick="return docLkSwitchTab(this)">Notas de Débito</a></li>
      </ul>
      <input type="text" id="docLkQ" class="form-control form-control-sm mb-2" placeholder="Buscar por folio...">
      <table class="table table-hover table-sm"><thead class="table-secondary"><tr><th>Folio</th><th>Fecha</th><th class="text-end">Total</th><th class="text-end">Pagos realizados</th><th class="text-end">Saldo disp.</th><th>Status</th></tr></thead>
      <tbody id="docLkBody"></tbody></table>
      <div class="d-flex justify-content-between align-items-center">
        <span id="docLkInfo" class="small text-muted"></span>
        <div><button class="btn btn-sm btn-outline-secondary" id="docLkPrev">‹</button> <button class="btn btn-sm btn-outline-secondary" id="docLkNext">›</button></div>
      </div>
    </div>
  </div>
</div></div>

<!-- Lookup SAT (Forma de Pago / Moneda) -->
<div class="modal fade modal-lookup" id="lookupSat" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg">
  <div class="modal-content">
    <div class="modal-header py-2"><h6 class="modal-title" id="satLkTitle">Seleccionar</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <input type="text" id="satLkQ" class="form-control form-control-sm mb-2" placeholder="Buscar por clave o descripción...">
      <table class="table table-hover table-sm"><thead class="table-secondary"><tr><th style="width:100px">Clave</th><th>Descripción</th></tr></thead>
      <tbody id="satLkBody"></tbody></table>
      <div class="d-flex justify-content-between align-items-center">
        <span id="satLkInfo" class="small text-muted"></span>
        <div><button class="btn btn-sm btn-outline-secondary" id="satLkPrev">‹</button> <button class="btn btn-sm btn-outline-secondary" id="satLkNext">›</button></div>
      </div>
    </div>
  </div>
</div></div>

<!-- ═══════════════ MODAL TIMBRAR ═══════════════ -->
<div class="modal fade" id="timbraPagoModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bi bi-file-earmark-check me-2 text-warning"></i>Timbrar Cobro</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="timbraPagoBody"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-warning btn-sm" id="btnConfirmTimbrarPago" onclick="ejecutarTimbradoPago()">
          <i class="bi bi-file-earmark-check me-1"></i>Confirmar timbrado
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════ MODAL CANCELAR (fiscal) ═══════════════ -->
<div class="modal fade" id="cancelarPagoModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bi bi-x-circle me-2 text-danger"></i>Cancelar Cobro (timbrado)</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="cancelarPagoError" class="alert alert-danger d-none py-2 small"></div>
        <label class="form-label small mb-1">Motivo de cancelación</label>
        <select id="cancMotivoPago" class="form-select form-select-sm mb-2" onchange="onCambiaMotivoPago()">
          <option value="01">01 - Comprobante emitido con errores con relación</option>
          <option value="02" selected>02 - Comprobante emitido con errores sin relación</option>
          <option value="03">03 - No se llevó a cabo la operación</option>
          <option value="04">04 - Operación nominativa relacionada en factura global</option>
        </select>
        <div id="rowFolioSustitucionPago" class="d-none">
          <label class="form-label small mb-1">UUID que sustituye</label>
          <input type="text" id="cancFolioSustitucionPago" class="form-control form-control-sm" maxlength="40">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
        <button type="button" class="btn btn-danger btn-sm" id="btnConfirmCancelarPago" onclick="ejecutarCancelacionFiscalPago()">
          <i class="bi bi-x-circle me-1"></i>Confirmar cancelación
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
<script>
const browse=initBrowse({searchInput:document.getElementById('searchInput'),searchColumn:document.getElementById('searchCol'),tableBody:document.getElementById('tableBody'),paginationEl:document.getElementById('pagination'),infoEl:document.getElementById('pageInfo'),fetchUrl:'/pagos/data',defaultSort:'Id_NoPago',defaultDir:'desc'});

const modal=new bootstrap.Modal(document.getElementById('frmModal'));
let _pago={idNoPago:null, confirmada:false, cliente:null, flagCompensacion:false};

// Con modales apilados (lookupCliente/lookupDoc/lookupSat sobre frmModal), el
// focus-trap de Bootstrap hace que ESC cierre el modal de abajo en vez del que
// está encima -- mismo fix ya usado en cartaporte.ejs/notacred.ejs.
document.addEventListener('keydown', function(e) {
  if (e.key !== 'Escape') return;
  const shown = document.querySelectorAll('.modal.show');
  if (shown.length <= 1) return;
  const top = bootstrap.Modal.getInstance(shown[shown.length - 1]);
  if (top) { e.preventDefault(); e.stopPropagation(); top.hide(); }
}, true);

function hoyISO(){return new Date().toISOString().slice(0,10);}
function fmtN(v){return (parseFloat(v)||0).toFixed(2);}
function fmtMoney(v){
  const n=parseFloat(v)||0;
  const signo=n<0?'-':'';
  return signo+'$'+Math.abs(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
}
// Para inputs de texto con máscara de dinero ($1,234.56) -- quita todo lo que
// no sea dígito/punto/signo antes de convertir a número.
function parseMoneyInput(v){return parseFloat(String(v==null?'':v).replace(/[^0-9.-]/g,''))||0;}
function showError(msg){const e=document.getElementById('frmError');e.textContent=msg;e.classList.remove('d-none');}
function hideError(){document.getElementById('frmError').classList.add('d-none');}
function showWarning(msg){const e=document.getElementById('frmWarning');e.textContent=msg;e.classList.remove('d-none');}
function hideWarning(){document.getElementById('frmWarning').classList.add('d-none');}

function clearForm(){
  _pago={idNoPago:null, confirmada:false, cliente:null, flagCompensacion:false};
  document.getElementById('f_Id_NoPago').value='';
  document.getElementById('f_Id_Cliente').value='';
  document.getElementById('f_NombreCom_disp').value='';
  document.getElementById('f_NombreCom_disp').readOnly=false;
  document.getElementById('f_RFC').value='';
  document.getElementById('f_Status').value='BORRADOR';
  document.getElementById('f_Id_RealPago').value='';
  document.getElementById('f_NomClientePago_disp').value='';
  document.getElementById('f_FlagCompensacion').checked=false;
  document.getElementById('filtroLineasQ').value='';
  document.getElementById('f_BancoDeposito').value='';
  document.getElementById('f_TipoDeposito').value='';
  document.getElementById('f_NoCheque').value='';
  document.getElementById('f_BancoEmisor').value='';
  document.getElementById('f_Fecha').value=hoyISO();
  document.getElementById('f_Fecha').disabled=false;
  document.getElementById('f_FechaPago').value=hoyISO();
  setSatField('f_c_FormaPago','f_c_FormaPago_disp','formaPago','03');
  setSatField('f_Moneda','f_Moneda_disp','moneda','MXN');
  document.getElementById('f_TipoCambio').value='';
  document.getElementById('rowTipoCambio').style.display='none';
  document.getElementById('f_Realizo_disp').textContent=USUARIO_ACTUAL;
  document.getElementById('detBody').innerHTML='';
  _lineasActuales=[];
  document.getElementById('detCount').textContent='0 documentos';
  document.getElementById('thComp').style.display='none';
  document.getElementById('totComp').style.display='none';
  pintarTotales([]);
  hideError(); hideWarning();
}
const USUARIO_ACTUAL="<%= usuario.nombre.trim() %> <%= usuario.apellido ? usuario.apellido.trim() : '' %>".trim();

function refrescarNumeroConsecutivo(){
  if(_pago.idNoPago) return;
  fetch('/pagos/lookup/numero-consecutivo').then(r=>r.json()).then(d=>{
    if(d.next!=null) document.getElementById('f_Id_NoPago').value=d.next;
  });
}

function openAdd(){
  clearForm();
  document.getElementById('frmTitle').textContent='Nuevo Pago';
  refrescarNumeroConsecutivo();
  modal.show();
}

function openEdit(){
  if(!window._selectedRow) return;
  clearForm();
  document.getElementById('frmTitle').textContent='Cobro #'+window._selectedRow.Id_NoPago;
  cargarPago(parseInt(window._selectedRow.Id_NoPago));
  modal.show();
}

function cargarPago(id, onDone){
  fetch(`/pagos/get?id=${id}`).then(r=>r.json()).then(d=>{
    if(d.error){showError(d.error);return;}
    const c=d.cabecera;
    _pago={idNoPago:c.Id_NoPago, confirmada:true, cliente:c.Id_Cliente, flagCompensacion:c.FlagCompensacion==1};
    document.getElementById('f_Id_NoPago').value=c.Id_NoPago;
    document.getElementById('f_Id_Cliente').value=c.Id_Cliente;
    document.getElementById('f_NombreCom_disp').value=(c.NombreCom||'').trim();
    document.getElementById('f_NombreCom_disp').readOnly=true;
    document.getElementById('f_RFC').value=(c.RFC||'').trim();
    document.getElementById('f_Status').value=(c.Status||'').trim();
    const yaTimbrado=!!(c.UUID||'').trim();
    document.getElementById('f_Id_RealPago').value=c.Id_RealPago||'';
    document.getElementById('f_NomClientePago_disp').value=(Number(c.Id_RealPago)!==Number(c.Id_Cliente))?(c.NomClientePago||'').trim():'';
    document.getElementById('f_FlagCompensacion').checked=c.FlagCompensacion==1;
    document.getElementById('f_BancoDeposito').value=(c.BancoDeposito||'').trim();
    document.getElementById('f_TipoDeposito').value=(c.TipoDeposito||'').trim();
    document.getElementById('f_NoCheque').value=(c.NoCheuqe||'').trim();
    document.getElementById('f_BancoEmisor').value=(c.BancoEmisor||'').trim();
    document.getElementById('f_Fecha').value=(c.Fecha||'').toString().slice(0,10);
    document.getElementById('f_Fecha').disabled=yaTimbrado;
    document.getElementById('f_FechaPago').value=(c.FechaPago||'').toString().slice(0,10);
    document.getElementById('f_FechaPago').disabled=yaTimbrado;
    document.querySelectorAll('.sat-lupa-btn').forEach(b=>b.disabled=yaTimbrado);
    setSatField('f_c_FormaPago','f_c_FormaPago_disp','formaPago',(c.c_FormaPago||'').trim());
    const monedaClave=(c.TipoFacturas||'').trim()==='Dolares'?'USD':'MXN';
    setSatField('f_Moneda','f_Moneda_disp','moneda',monedaClave);
    document.getElementById('rowTipoCambio').style.display=monedaClave==='USD'?'':'none';
    document.getElementById('f_TipoCambio').value=(c.TipoCambio||'').toString().trim();
    document.getElementById('f_Realizo_disp').textContent=(c.Realizo||'').trim()||USUARIO_ACTUAL;
    onFlagCompensacionUI();
    pintarDetalle(d.lineas);
    if(onDone) onDone(d);
  });
}

