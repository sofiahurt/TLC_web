DB_SERVER=localhost
DB_DATABASE=TLC
DB_USER=sa
DB_PASSWORD=tu_password
DB_PORT=1433
SESSION_SECRET=cambia_este_secreto
PORT=3000
# Opcional — sobrescribe la ruta al SQLite de catálogos SAT (por defecto: storage/catalogos/sat_catalogos.sqlite)
# SAT_CATALOGOS_DB_PATH=/ruta/alternativa/sat_catalogos.sqlite

# PAC de timbrado (CFDI) — ver app/services/cfdi-pac.js
# El PAC (URL) es el mismo para todas las Empresas/series, solo cambia entre
# prueba y producción (según el flag TESTFEL en dbo.Empresas para la serie).
# La credencial de producción sale de dbo.Empresas.USUARIO por empresa; la de
# prueba no existe ahí, por eso se define aquí.
PAC_URL_PRUEBA=https://url-de-prueba-del-pac/servicio
PAC_URL_PRODUCCION=https://url-de-produccion-del-pac/servicio
PAC_USUARIO_PRUEBA=usuario_pac_pruebas
# Nombre de la operación SOAP a invocar (cambiar a "timbrar3" si el PAC lo pide para CFDI 4.0)
PAC_OPERACION=timbrar
PAC_SOAP_NAMESPACE=urn:ws_api
# Solo si el SOAPAction real no sigue el patrón urn:ServicioTimbradoWS#<PAC_OPERACION>
# PAC_SOAP_ACTION=urn:ServicioTimbradoWS#timbrar
PAC_CONNECT_TIMEOUT_MS=15000
PAC_RESPONSE_TIMEOUT_MS=90000
